@Library('jenkins-shared-lib') _
pipeline {
    agent { label 'ssh-agent-with-docker' }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'WEBHOOK_PROJECT', value: '$.repository.name'],
                [key: 'WEBHOOK_REF', value: '$.ref']
            ],
            causeString: 'GitHub push: $WEBHOOK_PROJECT $WEBHOOK_REF',
            tokenCredentialId: 'flutter-android-build-webhook-token',
            printContributedVariables: false,
            printPostContent: false,
            silentResponse: false,
            regexpFilterText: '$WEBHOOK_REF',
            regexpFilterExpression: '^refs/heads/(main|master)$'
        )
    }
    parameters {
        string(name: 'PROJECT', defaultValue: 'taiwan-bus-app', description: 'GitHub repository slug to build')
        string(name: 'BRANCH', defaultValue: '', description: 'Git branch. Empty uses the project default branch.')
        choice(name: 'BUILD_TARGET', choices: ['appbundle-debug', 'appbundle-release', 'apk-debug', 'apk-release'], description: 'Flutter Android build target')
        booleanParam(name: 'PUBLISH_TO_PLAY', defaultValue: false, description: 'Upload release AAB to Google Play')
        choice(name: 'PLAY_TRACK', choices: ['internal', 'alpha', 'beta', 'production'], description: 'Google Play API track ID')
        choice(name: 'PLAY_RELEASE_STATUS', choices: ['draft', 'completed', 'inProgress'], description: 'Google Play release status')
        string(name: 'PLAY_ROLLOUT_FRACTION', defaultValue: '', description: 'Required for inProgress staged rollout, for example 0.05')
        booleanParam(name: 'PLAY_REQUIRE_PRODUCTION_APPROVAL', defaultValue: true, description: 'Require manual confirmation before production publish')
    }
    stages {
        stage('Resolve project') {
            steps {
                script {
                    def projectSlug = env.WEBHOOK_PROJECT?.trim() ?: params.PROJECT?.trim()
                    if (!projectSlug) {
                        error 'PROJECT is required'
                    }
                    def webhookBranch = env.WEBHOOK_REF?.trim()?.replaceFirst('^refs/heads/', '')
                    env.PROJECT_REPO = "git@github.com:maksonlee/${projectSlug}.git"
                    env.PROJECT_BRANCH = params.BRANCH?.trim() ?: webhookBranch ?: 'main'
                    env.PROJECT_CREDENTIALS_ID = 'vault-github-ssh'
                    // Keep the historical fallback for projects that have not
                    // pinned Flutter yet. A project's .fvmrc takes precedence.
                    env.DEFAULT_FLUTTER_VERSION = '3.44.0'
                    // This image contains Android, Dart, and FVM. The project
                    // Flutter SDK is installed into the mounted FVM cache.
                    env.FLUTTER_IMAGE = 'harbor.maksonlee.com/library/flutter-android-build-env:3.44.0-fvm'
                    env.PYTHON_TEST_IMAGE = 'python:3.13-bookworm'
                    env.POSTGIS_TEST_IMAGE = 'postgis/postgis:18-3.6'
                    env.FLUTTER_CACHE_ROOT = '/home/administrator/jenkins/flutter-cache'
                    env.ANDROID_CACHE_ROOT = '/home/administrator/jenkins/android-cache'
                    env.ARTIFACTORY_REPO = 'android-snapshots'
                    env.ARTIFACTORY_ORG_PATH = 'com/maksonlee'
                    env.ARTIFACTORY_MODULE = projectSlug
                    env.PLAY_SERVICE_VAULT_PATH = 'secret/jenkins/mobile/shared/play-service'
                }
            }
        }
        stage('Fetch image') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
docker pull "${FLUTTER_IMAGE}"
docker image inspect "${FLUTTER_IMAGE}" --format 'IMAGE_ID={{.Id}}'
'''
            }
        }
        stage('Fetch code') {
            steps {
                deleteDir()
                dir('source') {
                    git branch: env.PROJECT_BRANCH,
                        credentialsId: env.PROJECT_CREDENTIALS_ID,
                        url: env.PROJECT_REPO
                }
            }
        }
        stage('Resolve Flutter workdir') {
            steps {
                script {
                    def flutterProject = resolveFlutterWorkdir(sourceDir: 'source')
                    env.PROJECT_WORKDIR = flutterProject.workDir
                    env.PROJECT_VERSION_FILE = flutterProject.versionFile
                    def projectBase = env.PROJECT_WORKDIR == '.' ? 'source' : 'source/' + env.PROJECT_WORKDIR
                    def fvmConfigFile = projectBase + '/.fvmrc'
                    env.FLUTTER_VERSION = env.DEFAULT_FLUTTER_VERSION
                    if (fileExists(fvmConfigFile)) {
                        def fvmConfig = readFile(file: fvmConfigFile)
                        def flutterKey = '"flutter"'
                        def keyOffset = fvmConfig.indexOf(flutterKey)
                        def colonOffset = keyOffset < 0
                            ? -1
                            : fvmConfig.indexOf(':', keyOffset + flutterKey.length())
                        def valueStart = colonOffset < 0 ? -1 : fvmConfig.indexOf('"', colonOffset + 1)
                        def valueEnd = valueStart < 0 ? -1 : fvmConfig.indexOf('"', valueStart + 1)
                        if (valueStart < 0 || valueEnd <= valueStart + 1) {
                            error "Invalid FVM configuration: ${fvmConfigFile}"
                        }
                        env.FLUTTER_VERSION = fvmConfig.substring(valueStart + 1, valueEnd).trim()
                    }
                    echo "Flutter workdir: ${env.PROJECT_WORKDIR}"
                    echo "Version file: ${env.PROJECT_VERSION_FILE}"
                    echo "Flutter version: ${env.FLUTTER_VERSION}"
                }
            }
        }
        stage('Resolve Android applicationId') {
            steps {
                script {
                    def androidApp = resolveAndroidApplicationId(
                        sourceDir: 'source',
                        workDir: env.PROJECT_WORKDIR
                    )
                    env.PLAY_PACKAGE_NAME = androidApp.playPackageName
                    env.KEYSTORE_VAULT_PATH = androidApp.keystoreVaultPath
                    echo "Android applicationId: ${env.PLAY_PACKAGE_NAME}"
                    echo "applicationId file: ${androidApp.applicationIdFile}"
                    echo "Keystore Vault path: ${env.KEYSTORE_VAULT_PATH}"
                }
            }
        }
        stage('Resolve Google Play metadata') {
            steps {
                script {
                    def projectBase = env.PROJECT_WORKDIR == '.' ? 'source' : "source/${env.PROJECT_WORKDIR}"
                    def playMetadataRoot = "${projectBase}/android/app/src/main/play"
                    env.PLAY_METADATA_ROOT = playMetadataRoot
                    if (fileExists("${playMetadataRoot}/listings")) {
                        echo "PLAY_LISTINGS_ROOT=${playMetadataRoot}/listings"
                    } else {
                        echo "No Google Play listing metadata found at ${playMetadataRoot}/listings"
                    }
                    def releaseNotesRoot = "${projectBase}/android/app/src/main/play/release-notes"
                    def releaseNotesByLanguage = [:]
                    def releaseNoteSources = []
                    if (fileExists(releaseNotesRoot)) {
                        def languageOutput = sh(
                            returnStdout: true,
                            script: """#!/bin/bash
set -euo pipefail
find "${releaseNotesRoot}" -mindepth 1 -maxdepth 1 -type d -printf '%f\\n' | sort
"""
                        ).trim()
                        def languages = languageOutput ? languageOutput.readLines() : []
                        languages.each { language ->
                            if (!(language ==~ /^[a-z]{2,3}(?:-[A-Z][A-Za-z0-9]{1,7})?$/)) {
                                error "Invalid Google Play release note language: ${language}"
                            }
                            def candidates = [
                                "${releaseNotesRoot}/${language}/${params.PLAY_TRACK}.txt",
                                "${releaseNotesRoot}/${language}/default.txt"
                            ]
                            def releaseNotesPath = candidates.find { fileExists(it) }
                            if (releaseNotesPath) {
                                def releaseNotes = readFile(releaseNotesPath).trim()
                                if (!releaseNotes) {
                                    error "Google Play release notes are empty: ${releaseNotesPath}"
                                }
                                if (releaseNotes.length() > 500) {
                                    error "Google Play release notes exceed 500 characters for ${language}: ${releaseNotes.length()}"
                                }
                                releaseNotesByLanguage[language] = releaseNotes
                                releaseNoteSources.add(releaseNotesPath)
                            }
                        }
                    }
                    if (releaseNotesByLanguage) {
                        def previewLanguage = releaseNotesByLanguage.containsKey('en-US') ?
                            'en-US' : releaseNotesByLanguage.keySet().toList().sort()[0]
                        env.PLAY_RELEASE_NOTES = releaseNotesByLanguage[previewLanguage]
                        writeFile(
                            file: '.play-release-notes.json',
                            text: groovy.json.JsonOutput.prettyPrint(
                                groovy.json.JsonOutput.toJson(releaseNotesByLanguage)
                            ) + '\n'
                        )
                        echo "PLAY_RELEASE_NOTES_LANGUAGES=${releaseNotesByLanguage.keySet().toList().sort().join(',')}"
                        echo "PLAY_RELEASE_NOTES_SOURCES=${releaseNoteSources.join(',')}"
                    } else if (params.PUBLISH_TO_PLAY && params.BUILD_TARGET == 'appbundle-release') {
                        error "Missing Google Play release notes metadata in ${releaseNotesRoot}"
                    } else {
                        env.PLAY_RELEASE_NOTES = ''
                        echo "No Google Play release notes metadata found for non-publish build."
                    }
                }
            }
        }
        stage('Google Play version preflight') {
            when {
                expression {
                    params.PUBLISH_TO_PLAY &&
                        params.BUILD_TARGET == 'appbundle-release'
                }
            }
            steps {
                script {
                    if (!env.PLAY_SERVICE_VAULT_PATH) {
                        error "No playServiceVaultPath configured for PROJECT=${params.PROJECT}"
                    }
                    if (!env.PLAY_PACKAGE_NAME) {
                        error "No packageName configured for PROJECT=${params.PROJECT}"
                    }
                    def versionFile = "source/${env.PROJECT_VERSION_FILE}"
                    def versionLine = readFile(versionFile)
                        .readLines()
                        .collect { it.trim() }
                        .find { it.startsWith('version:') }
                    if (!versionLine) {
                        error "Cannot find Flutter version in ${versionFile}"
                    }
                    def versionValue = versionLine.substring('version:'.length()).trim()
                    def versionParts = versionValue.split('\\+', -1)
                    if (
                        versionParts.size() != 2 ||
                        !(versionParts[0] ==~ /^[0-9]+\.[0-9]+\.[0-9]+$/) ||
                        !(versionParts[1] ==~ /^[0-9]+$/) ||
                        versionParts[1].toInteger() <= 0
                    ) {
                        error "Flutter version must use semanticVersion+positiveVersionCode: ${versionValue}"
                    }
                    env.PLAY_VERSION_NAME = versionParts[0]
                    env.PLAY_VERSION_CODE = versionParts[1]
                    echo "Google Play preflight version: ${env.PLAY_VERSION_NAME}+${env.PLAY_VERSION_CODE}"

                    withVault([vaultSecrets: [[
                        path: env.PLAY_SERVICE_VAULT_PATH,
                        engineVersion: 2,
                        secretValues: [[envVar: 'PLAY_SERVICE_JSON_B64', vaultKey: 'json_b64']]
                    ]]]) {
                        sh '''#!/bin/bash
set -euo pipefail
umask 077
: "${PLAY_SERVICE_JSON_B64:?ERROR: PLAY_SERVICE_JSON_B64 is empty or unset}"
play_json="$PWD/play-preflight-service.json"
trap 'rm -f "$play_json"' EXIT
printf %s "${PLAY_SERVICE_JSON_B64}" | sed 's/^data:[^,]*,//' | tr -d '\r\n ' | base64 -d > "$play_json"
python3 - "$play_json" "$PLAY_PACKAGE_NAME" "$PLAY_VERSION_NAME" "$PLAY_VERSION_CODE" <<'PY'
import base64
import json
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

service_json, package_name, version_name, expected_version_code_text = sys.argv[1:]
expected_version_code = int(expected_version_code_text)
with open(service_json, 'r', encoding='utf-8') as file:
    service = json.load(file)

def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b'=').decode('ascii')

now = int(time.time())
header = {'alg': 'RS256', 'typ': 'JWT'}
payload = {
    'iss': service['client_email'],
    'scope': 'https://www.googleapis.com/auth/androidpublisher',
    'aud': 'https://oauth2.googleapis.com/token',
    'iat': now,
    'exp': now + 3600,
}
signing_input = (
    b64url(json.dumps(header, separators=(',', ':')).encode('utf-8'))
    + '.'
    + b64url(json.dumps(payload, separators=(',', ':')).encode('utf-8'))
)
with tempfile.NamedTemporaryFile('w', encoding='utf-8') as key_file:
    key_file.write(service['private_key'])
    key_file.flush()
    signature = subprocess.check_output(
        ['openssl', 'dgst', '-sha256', '-sign', key_file.name],
        input=signing_input.encode('ascii'),
    )
assertion = signing_input + '.' + b64url(signature)

def request_json(method, url, token=None, data=None, content_type='application/json'):
    headers = {}
    if token:
        headers['Authorization'] = f'Bearer {token}'
    body = data
    if isinstance(data, (dict, list)):
        body = json.dumps(data).encode('utf-8')
        headers['Content-Type'] = content_type
    elif data is not None:
        headers['Content-Type'] = content_type
    request = urllib.request.Request(
        url,
        data=body,
        headers=headers,
        method=method,
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw = response.read().decode('utf-8')
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as error:
        detail = error.read().decode('utf-8', errors='replace')
        raise SystemExit(
            f'Google Play API {method} failed: HTTP {error.code}\\n{detail}'
        )

token_response = request_json(
    'POST',
    'https://oauth2.googleapis.com/token',
    data=urllib.parse.urlencode({
        'grant_type': 'urn:ietf:params:oauth:grant-type:jwt-bearer',
        'assertion': assertion,
    }).encode('utf-8'),
    content_type='application/x-www-form-urlencoded',
)
token = token_response['access_token']
base = (
    'https://androidpublisher.googleapis.com/androidpublisher/v3/applications/'
    + urllib.parse.quote(package_name, safe='')
)
edit = request_json('POST', base + '/edits', token=token, data={})
edit_id = edit['id']
try:
    bundles = request_json(
        'GET',
        base + f'/edits/{urllib.parse.quote(edit_id, safe="")}/bundles',
        token=token,
    ).get('bundles', [])
    existing_version_codes = sorted(
        int(bundle['versionCode'])
        for bundle in bundles
        if bundle.get('versionCode') is not None
    )
finally:
    request_json(
        'DELETE',
        base + f'/edits/{urllib.parse.quote(edit_id, safe="")}',
        token=token,
    )

highest_version_code = max(existing_version_codes, default=0)
print(
    f'Google Play highest versionCode: {highest_version_code}; '
    f'candidate: {version_name}+{expected_version_code}'
)
if expected_version_code <= highest_version_code:
    raise SystemExit(
        f'Google Play versionCode must be greater than {highest_version_code}; '
        f'candidate {expected_version_code} has already been used or is stale.'
    )
PY
rm -f "$play_json"
'''
                    }
                }
            }
        }
        stage('Backend and metadata tests') {
            steps {
                script {
                    if (fileExists('source/tests') && fileExists('source/requirements-dev.txt')) {
                        sh '''#!/bin/bash
set -euo pipefail
test_id=$(printf %s "quality-${BUILD_TAG}" | tr -c 'A-Za-z0-9_.-' '-')
test_network=""
test_db=""

cleanup() {
  if [ -n "${test_db}" ]; then
    docker rm -f "${test_db}" >/dev/null 2>&1 || true
  fi
  if [ -n "${test_network}" ]; then
    docker network rm "${test_network}" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

docker pull "${PYTHON_TEST_IMAGE}"
docker_args=(
  --rm
  -e PYTHONDONTWRITEBYTECODE=1
  -e COVERAGE_FILE=/tmp/.coverage
  -e PIP_ROOT_USER_ACTION=ignore
  -v "$PWD/source:/workspace:ro"
  -w /workspace
)

if [ -f source/tests/test_database_integration.py ]; then
  docker pull "${POSTGIS_TEST_IMAGE}"
  test_network="${test_id}-network"
  test_db="${test_id}-db"
  docker network create "${test_network}" >/dev/null
  docker run -d --rm \
    --name "${test_db}" \
    --network "${test_network}" \
    -e POSTGRES_PASSWORD=test-password \
    -e POSTGRES_DB=taiwan_bus_test \
    "${POSTGIS_TEST_IMAGE}" >/dev/null
  ready=false
  ready_checks=0
  for _ in $(seq 1 60); do
    if docker exec "${test_db}" pg_isready -U postgres -d taiwan_bus_test >/dev/null 2>&1; then
      ready_checks=$((ready_checks + 1))
      if [ "${ready_checks}" -ge 3 ]; then
        ready=true
        break
      fi
    else
      ready_checks=0
    fi
    sleep 1
  done
  if [ "${ready}" != true ]; then
    docker logs "${test_db}" >&2
    echo "PostgreSQL/PostGIS test database did not become ready." >&2
    exit 1
  fi
  docker_args+=(
    --network "${test_network}"
    -e "TEST_DATABASE_URL=postgresql://postgres:test-password@${test_db}:5432/taiwan_bus_test"
  )
fi

docker run "${docker_args[@]}" "${PYTHON_TEST_IMAGE}" bash -lc '
  set -euo pipefail
  apt-get update >/dev/null
  apt-get install -y --no-install-recommends postgresql-client >/dev/null
  git config --global --add safe.directory /workspace
  python -m pip install --disable-pip-version-check -r requirements-dev.txt
  python -m pip check
  if [ -f scripts/validate_play_metadata.py ]; then
    python scripts/validate_play_metadata.py
  fi
  python -m coverage run --branch -m unittest discover -s tests -v
  python -m coverage report --fail-under=35
'
'''
                    } else if (fileExists('source/scripts/validate_play_metadata.py')) {
                        sh '''#!/bin/bash
set -euo pipefail
docker pull "${PYTHON_TEST_IMAGE}"
docker run --rm \
  -e PYTHONDONTWRITEBYTECODE=1 \
  -v "$PWD/source:/workspace:ro" \
  -w /workspace \
  "${PYTHON_TEST_IMAGE}" \
  python scripts/validate_play_metadata.py
'''
                    } else {
                        echo 'No Python tests or Play metadata validator found; skipping backend checks.'
                    }
                }
            }
        }
        stage('Prepare release signing') {
            when {
                expression { params.BUILD_TARGET.contains('release') }
            }
            steps {
                script {
                    if (!env.KEYSTORE_VAULT_PATH) {
                        error "No keystoreVaultPath configured for PROJECT=${params.PROJECT}"
                    }
                    withVault([vaultSecrets: [[
                        path: env.KEYSTORE_VAULT_PATH,
                        engineVersion: 2,
                        secretValues: [
                            [envVar: 'UPLOAD_JKS_B64', vaultKey: 'upload_jks_b64'],
                            [envVar: 'STORE_PASSWORD', vaultKey: 'store_password'],
                            [envVar: 'KEY_PASSWORD', vaultKey: 'key_password'],
                            [envVar: 'KEY_ALIAS', vaultKey: 'key_alias']
                        ]
                    ]]]) {
                        sh '''#!/bin/bash
set -euo pipefail
umask 077
signing_dir="source/${PROJECT_WORKDIR}/android"
mkdir -p "${signing_dir}"
: "${UPLOAD_JKS_B64:?ERROR: UPLOAD_JKS_B64 is empty or unset}"
: "${STORE_PASSWORD:?ERROR: STORE_PASSWORD is empty or unset}"
: "${KEY_PASSWORD:?ERROR: KEY_PASSWORD is empty or unset}"
: "${KEY_ALIAS:?ERROR: KEY_ALIAS is empty or unset}"
printf %s "${UPLOAD_JKS_B64}" | sed 's/^data:[^,]*,//' | tr -d '\r\n ' | base64 -d > "${signing_dir}/upload-keystore.jks"
chmod 600 "${signing_dir}/upload-keystore.jks"
cat > "${signing_dir}/key.properties" <<EOF
storePassword=${STORE_PASSWORD}
keyPassword=${KEY_PASSWORD}
keyAlias=${KEY_ALIAS}
storeFile=upload-keystore.jks
EOF
chmod 600 "${signing_dir}/key.properties"
echo "Release signing files prepared. JKS bytes: $(wc -c < "${signing_dir}/upload-keystore.jks")"
'''
                    }
                }
            }
        }
        stage('Build') {
            steps {
                script {
                    def flutterBin = "/home/ubuntu/fvm/versions/${env.FLUTTER_VERSION}/bin/flutter"
                    def projectBase = env.PROJECT_WORKDIR == '.' ? 'source' : 'source/' + env.PROJECT_WORKDIR
                    def qualityCommands = [
                        "${flutterBin} pub get",
                        "${flutterBin} analyze --no-pub"
                    ]
                    if (fileExists("${projectBase}/test")) {
                        qualityCommands.add("${flutterBin} test --coverage --branch-coverage --no-pub")
                    } else {
                        echo "No Flutter tests found at ${projectBase}/test"
                    }
                    if (fileExists("${projectBase}/android/app")) {
                        qualityCommands.add("./android/gradlew -p android :app:lintDebug --no-daemon")
                    } else {
                        echo "No Android app found at ${projectBase}/android/app"
                    }
                    if (fileExists("${projectBase}/android/app/src/test")) {
                        qualityCommands.add("./android/gradlew -p android :app:testDebugUnitTest --no-daemon")
                    } else {
                        echo "No Android app unit tests found at ${projectBase}/android/app/src/test"
                    }
                    def commandByTarget = [
                        'appbundle-debug': "${flutterBin} build appbundle --debug --no-pub --no-android-gradle-daemon",
                        // Release builds must regenerate mode-specific platform tooling after
                        // debug tests. With --no-pub, Flutter can leave dev-only plugins in
                        // GeneratedPluginRegistrant while excluding them from release dependencies.
                        'appbundle-release': "${flutterBin} build appbundle --release --no-android-gradle-daemon",
                        'apk-debug': "${flutterBin} build apk --debug --no-pub --no-android-gradle-daemon",
                        'apk-release': "${flutterBin} build apk --release --no-android-gradle-daemon"
                    ]
                    def artifactBase = env.PROJECT_WORKDIR == '.' ? 'source' : 'source/' + env.PROJECT_WORKDIR
                    def artifactByTarget = [
                        'appbundle-debug': artifactBase + '/build/app/outputs/bundle/debug/*.aab',
                        'appbundle-release': artifactBase + '/build/app/outputs/bundle/release/*.aab',
                        'apk-debug': artifactBase + '/build/app/outputs/flutter-apk/*.apk',
                        'apk-release': artifactBase + '/build/app/outputs/flutter-apk/*.apk'
                    ]
                    env.FLUTTER_BUILD_COMMAND = (
                        qualityCommands + [commandByTarget[params.BUILD_TARGET]]
                    ).join(' && ')
                    env.FLUTTER_ARTIFACTS = artifactByTarget[params.BUILD_TARGET]
                    if (!env.FLUTTER_BUILD_COMMAND) error "Unknown BUILD_TARGET: ${params.BUILD_TARGET}"
                }
                sh '''#!/bin/bash
set -euo pipefail
uid=$(id -u)
gid=$(id -g)
flutter_cache_root="${FLUTTER_CACHE_ROOT}"
android_cache_root="${ANDROID_CACHE_ROOT}"
android_cache="${android_cache_root}/flutter-android-sdk"
fvm_cache="${flutter_cache_root}/fvm"
gradle_cache="${android_cache_root}/gradle"
pub_cache="${flutter_cache_root}/pub-cache"
mkdir -p "${android_cache}" "${gradle_cache}" "${pub_cache}" "${fvm_cache}"

if [ ! -d "${android_cache}/cmdline-tools/latest" ]; then
  echo "Seeding Android command-line tools into ${android_cache}"
  seed_container=$(docker create "${FLUTTER_IMAGE}")
  trap 'docker rm -f "${seed_container}" >/dev/null 2>&1 || true' EXIT
  docker cp "${seed_container}:/home/ubuntu/Android/cmdline-tools" "${android_cache}/"
  docker rm "${seed_container}" >/dev/null
  trap - EXIT
fi

mkdir -p \
  "${android_cache}/platforms" \
  "${android_cache}/build-tools" \
  "${android_cache}/platform-tools" \
  "${android_cache}/ndk" \
  "${android_cache}/cmake" \
  "${android_cache}/licenses"

echo "FLUTTER_CACHE_ROOT=${flutter_cache_root}"
echo "ANDROID_CACHE_ROOT=${android_cache_root}"
echo "FLUTTER_CACHE_SIZE_BEFORE=$(du -sh "${flutter_cache_root}" 2>/dev/null | cut -f1)"
echo "ANDROID_CACHE_SIZE_BEFORE=$(du -sh "${android_cache_root}" 2>/dev/null | cut -f1)"
start=$(date +%s)

docker run --rm \
  -u ${uid}:${gid} \
  -e HOME=/home/ubuntu \
  -e ANDROID_HOME=/home/ubuntu/Android \
  -e ANDROID_SDK_ROOT=/home/ubuntu/Android \
  -e FVM_CACHE_PATH=/home/ubuntu/fvm \
  -e PUB_CACHE=/home/ubuntu/pub-cache \
  -v "${android_cache}:/home/ubuntu/Android" \
  -v "${fvm_cache}:/home/ubuntu/fvm" \
  -v "${gradle_cache}:/home/ubuntu/.gradle" \
  -v "${pub_cache}:/home/ubuntu/pub-cache" \
  -v "$PWD/source:/workspace" \
  -w "/workspace/${PROJECT_WORKDIR}" \
  "${FLUTTER_IMAGE}" \
  bash -lc "yes | sdkmanager --licenses && fvm install ${FLUTTER_VERSION} && /home/ubuntu/fvm/versions/${FLUTTER_VERSION}/bin/flutter config --no-analytics && /home/ubuntu/fvm/versions/${FLUTTER_VERSION}/bin/flutter --version && ${FLUTTER_BUILD_COMMAND}"

coverage_file="source/${PROJECT_WORKDIR}/coverage/lcov.info"
coverage_minimum_file="source/${PROJECT_WORKDIR}/coverage-minimum.txt"
branch_coverage_minimum_file="source/${PROJECT_WORKDIR}/branch-coverage-minimum.txt"
if [ -f "${coverage_file}" ]; then
  minimum=0
  branch_minimum=0
  enforce_branch_minimum=false
  if [ -s "${coverage_minimum_file}" ]; then
    minimum=$(tr -d '[:space:]' < "${coverage_minimum_file}")
    if ! [[ "${minimum}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      echo "Invalid Flutter coverage minimum: ${minimum}" >&2
      exit 1
    fi
  fi
  if [ -s "${branch_coverage_minimum_file}" ]; then
    branch_minimum=$(tr -d '[:space:]' < "${branch_coverage_minimum_file}")
    if ! [[ "${branch_minimum}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      echo "Invalid Flutter branch coverage minimum: ${branch_minimum}" >&2
      exit 1
    fi
    enforce_branch_minimum=true
  fi
  awk -F: -v minimum="${minimum}" -v branch_minimum="${branch_minimum}" \
    -v enforce_branch_minimum="${enforce_branch_minimum}" '
    /^LF:/ { lines_found += $2 }
    /^LH:/ { lines_hit += $2 }
    /^BRDA:/ {
      branches_found++
      split($2, branch_fields, ",")
      if (branch_fields[4] != "-" && branch_fields[4] + 0 > 0) branches_hit++
    }
    END {
      percentage = lines_found ? (100 * lines_hit / lines_found) : 0
      printf "FLUTTER_LINE_COVERAGE=%.2f%% (%d/%d), minimum=%.2f%%\\n",
        percentage, lines_hit, lines_found, minimum
      failed = !lines_found || percentage + 0.00001 < minimum

      if (branches_found || enforce_branch_minimum == "true") {
        branch_percentage = branches_found ? (100 * branches_hit / branches_found) : 0
        printf "FLUTTER_BRANCH_COVERAGE=%.2f%% (%d/%d), minimum=%.2f%%\\n",
          branch_percentage, branches_hit, branches_found, branch_minimum
        if (!branches_found || branch_percentage + 0.00001 < branch_minimum) failed = 1
      }

      if (failed) exit 1
    }
  ' "${coverage_file}"
fi

end=$(date +%s)
echo "TOTAL_SECONDS=$((end-start))"
echo "FLUTTER_CACHE_SIZE_AFTER=$(du -sh "${flutter_cache_root}" 2>/dev/null | cut -f1)"
echo "ANDROID_CACHE_SIZE_AFTER=$(du -sh "${android_cache_root}" 2>/dev/null | cut -f1)"
for d in "${flutter_cache_root}"/* "${android_cache_root}"/*; do
  if [ -d "$d" ]; then du -sh "$d"; fi
done | sort -h || true
ls -lh ${FLUTTER_ARTIFACTS}
'''
                script {
                    def projectBase = env.PROJECT_WORKDIR == '.' ? 'source' : 'source/' + env.PROJECT_WORKDIR
                    archiveArtifacts(
                        artifacts: "${projectBase}/coverage/lcov.info",
                        allowEmptyArchive: true,
                        fingerprint: false
                    )
                    junit(
                        testResults: "${projectBase}/build/app/test-results/testDebugUnitTest/TEST-*.xml",
                        allowEmptyResults: true
                    )
                }
            }
        }
        stage('Connected Android tests') {
            when {
                expression {
                    def projectBase = env.PROJECT_WORKDIR == '.' ? 'source' : 'source/' + env.PROJECT_WORKDIR
                    fileExists("${projectBase}/connected-device-minimum.txt")
                }
            }
            steps {
                sh '''#!/bin/bash
set -euo pipefail
project_base="source/${PROJECT_WORKDIR}"
minimum_file="${project_base}/connected-device-minimum.txt"
minimum=$(tr -d '[:space:]' < "${minimum_file}")
if ! [[ "${minimum}" =~ ^[1-9][0-9]*$ ]]; then
  echo "Invalid connected Android device minimum: ${minimum}" >&2
  exit 1
fi

android_sdk="${ANDROID_CACHE_ROOT}/flutter-android-sdk"
adb_bin="${android_sdk}/platform-tools/adb"
host_flutter="${FLUTTER_CACHE_ROOT}/fvm/versions/${FLUTTER_VERSION}/bin/flutter"
if [ ! -x "${adb_bin}" ] || [ ! -x "${host_flutter}" ]; then
  echo "Connected-test tooling is unavailable on this Jenkins agent." >&2
  exit 1
fi

"${adb_bin}" start-server >/dev/null
mapfile -t device_serials < <("${adb_bin}" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
echo "CONNECTED_ANDROID_DEVICES=${#device_serials[@]}, minimum=${minimum}"
if [ "${#device_serials[@]}" -lt "${minimum}" ]; then
  echo "Not enough authorized Android devices are connected." >&2
  "${adb_bin}" devices -l
  exit 1
fi

export ANDROID_HOME="${android_sdk}"
export ANDROID_SDK_ROOT="${android_sdk}"
export PATH="${android_sdk}/platform-tools:${PATH}"
cd "${project_base}"

mapfile -t integration_tests < <(find integration_test -type f -name '*_test.dart' -print 2>/dev/null | sort)
if [ "${#integration_tests[@]}" -gt 0 ]; then
  for serial in "${device_serials[@]}"; do
    for test_file in "${integration_tests[@]}"; do
      echo "Running ${test_file} on ${serial}"
      "${host_flutter}" test "${test_file}" -d "${serial}" --no-pub
    done
  done
else
  echo "No Flutter integration tests found."
fi

if [ -d android/app/src/androidTest ]; then
  ./android/gradlew -p android :app:connectedDebugAndroidTest --no-daemon
else
  echo "No Android instrumentation tests found."
fi
'''
                script {
                    def projectBase = env.PROJECT_WORKDIR == '.' ? 'source' : 'source/' + env.PROJECT_WORKDIR
                    junit(
                        testResults: "${projectBase}/build/app/outputs/androidTest-results/connected/**/*.xml",
                        allowEmptyResults: true
                    )
                }
            }
        }
        stage('Archive artifacts') {
            steps {
                archiveArtifacts artifacts: env.FLUTTER_ARTIFACTS, fingerprint: true
            }
        }
        stage('Upload to Artifactory') {
            steps {
                script {
                    def versionText = readFile("source/${env.PROJECT_VERSION_FILE}")
                    def baseRev = null
                    versionText.readLines().each { line ->
                        def trimmed = line.trim()
                        if (baseRev == null && trimmed.startsWith('version:')) {
                            baseRev = trimmed.substring('version:'.length()).trim().split('\\+')[0]
                        }
                    }
                    if (!baseRev) {
                        error "Cannot find version in source/${env.PROJECT_VERSION_FILE}"
                    }

                    def extByTarget = [
                        'appbundle-debug': 'aab',
                        'appbundle-release': 'aab',
                        'apk-debug': 'apk',
                        'apk-release': 'apk'
                    ]
                    def ext = extByTarget[params.BUILD_TARGET]
                    if (!ext) error "Unknown BUILD_TARGET: ${params.BUILD_TARGET}"

                    def timestamp = new Date().format('yyyyMMdd.HHmmss', TimeZone.getTimeZone('UTC'))
                    def fileItegRev = "${timestamp}-${env.BUILD_NUMBER}"
                    def targetBase = "${env.ARTIFACTORY_REPO}/${env.ARTIFACTORY_ORG_PATH}/${env.ARTIFACTORY_MODULE}/${baseRev}-SNAPSHOT"
                    def targetFile = "${env.ARTIFACTORY_MODULE}-${baseRev}-${fileItegRev}.${ext}"
                    def spec = """{
  "files": [
    {
      "pattern": "${env.FLUTTER_ARTIFACTS}",
      "target": "${targetBase}/${targetFile}",
      "flat": true
    }
  ]
}"""

                    echo "Uploading artifacts to: ${targetBase}"
                    echo "Artifactory file: ${targetFile}"
                    rtUpload(serverId: 'artifactory', spec: spec, failNoOp: true)
                }
            }
        }
        stage('Approve production publish?') {
            when {
                expression {
                    params.PUBLISH_TO_PLAY &&
                        params.BUILD_TARGET == 'appbundle-release' &&
                        params.PLAY_TRACK == 'production' &&
                        params.PLAY_REQUIRE_PRODUCTION_APPROVAL
                }
            }
            steps {
                input message: "Publish ${env.PLAY_PACKAGE_NAME} to Google Play production as ${params.PLAY_RELEASE_STATUS}? ${env.PLAY_RELEASE_NOTES}"
            }
        }
        stage('Upload to Google Play') {
            when {
                expression { params.PUBLISH_TO_PLAY && params.BUILD_TARGET == 'appbundle-release' }
            }
            steps {
                script {
                    if (!env.PLAY_SERVICE_VAULT_PATH) {
                        error "No playServiceVaultPath configured for PROJECT=${params.PROJECT}"
                    }
                    if (!env.PLAY_PACKAGE_NAME) {
                        error "No packageName configured for PROJECT=${params.PROJECT}"
                    }
                    if (!env.PLAY_RELEASE_NOTES?.trim()) {
                        error "No Google Play release notes loaded for PROJECT=${params.PROJECT}"
                    }
                    withVault([vaultSecrets: [[
                        path: env.PLAY_SERVICE_VAULT_PATH,
                        engineVersion: 2,
                        secretValues: [[envVar: 'PLAY_SERVICE_JSON_B64', vaultKey: 'json_b64']]
                    ]]]) {
                        sh '''#!/bin/bash
set -euo pipefail
umask 077
: "${PLAY_SERVICE_JSON_B64:?ERROR: PLAY_SERVICE_JSON_B64 is empty or unset}"
play_json="$PWD/play-service.json"
trap 'rm -f "$play_json"' EXIT
aab_path=$(ls ${FLUTTER_ARTIFACTS} | head -n 1)
release_notes_path="$PWD/.play-release-notes.json"
if [ ! -s "$release_notes_path" ]; then
  echo "Missing Google Play release notes file: $release_notes_path" >&2
  exit 1
fi
printf %s "${PLAY_SERVICE_JSON_B64}" | sed 's/^data:[^,]*,//' | tr -d '\r\n ' | base64 -d > "$play_json"
python3 - "$play_json" "$aab_path" "$PLAY_PACKAGE_NAME" "$PLAY_TRACK" "$PLAY_RELEASE_STATUS" "${PLAY_ROLLOUT_FRACTION:-}" "$release_notes_path" <<'PY'
import base64
import json
import os
import pathlib
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

service_json, aab_path, package_name, track, release_status, rollout_fraction, release_notes_path = sys.argv[1:]
with open(service_json, 'r', encoding='utf-8') as f:
    svc = json.load(f)
with open(release_notes_path, 'r', encoding='utf-8') as f:
    release_notes_by_language = json.load(f)
if not isinstance(release_notes_by_language, dict) or not release_notes_by_language:
    raise SystemExit('Google Play release notes are required')
release_notes = []
for language, text in sorted(release_notes_by_language.items()):
    if not isinstance(language, str) or not isinstance(text, str) or not text.strip():
        raise SystemExit(f'Invalid Google Play release note for language: {language!r}')
    normalized_text = text.strip()
    if len(normalized_text) > 500:
        raise SystemExit(
            f'Google Play release notes exceed 500 characters for {language}: '
            f'{len(normalized_text)}'
        )
    release_notes.append({
        'language': language,
        'text': normalized_text,
    })

def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b'=').decode('ascii')

now = int(time.time())
header = {'alg': 'RS256', 'typ': 'JWT'}
payload = {
    'iss': svc['client_email'],
    'scope': 'https://www.googleapis.com/auth/androidpublisher',
    'aud': 'https://oauth2.googleapis.com/token',
    'iat': now,
    'exp': now + 3600,
}
signing_input = f"{b64url(json.dumps(header, separators=(',', ':')).encode())}.{b64url(json.dumps(payload, separators=(',', ':')).encode())}"
with tempfile.NamedTemporaryFile('w', delete=False) as key_file:
    key_file.write(svc['private_key'])
    key_path = key_file.name
try:
    signature = subprocess.check_output(['openssl', 'dgst', '-sha256', '-sign', key_path], input=signing_input.encode('ascii'))
finally:
    try:
        os.remove(key_path)
    except OSError:
        pass
assertion = signing_input + '.' + b64url(signature)

def request_json(method, url, token=None, data=None, content_type='application/json'):
    body = None
    headers = {}
    if token:
        headers['Authorization'] = f'Bearer {token}'
    if data is not None:
        if isinstance(data, (dict, list)):
            body = json.dumps(data).encode('utf-8')
            headers['Content-Type'] = content_type
        else:
            body = data
            headers['Content-Type'] = content_type
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=300) as resp:
            raw = resp.read().decode('utf-8')
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        err = e.read().decode('utf-8', errors='replace')
        raise SystemExit(f'HTTP {e.code} {method} {url}\\n{err}')

def read_required_text(path):
    if not path.is_file():
        raise SystemExit(f'Missing Play listing metadata file: {path}')
    text = path.read_text(encoding='utf-8').strip()
    if not text:
        raise SystemExit(f'Play listing metadata file is empty: {path}')
    return text

def content_type_for_image(path):
    suffix = path.suffix.lower()
    if suffix == '.png':
        return 'image/png'
    if suffix in ('.jpg', '.jpeg'):
        return 'image/jpeg'
    raise SystemExit(f'Unsupported Play listing image type: {path}')

def validate_listing_lengths(language, title, short_description, full_description):
    limits = {
        'title': (title, 50),
        'short description': (short_description, 80),
        'full description': (full_description, 4000),
    }
    for name, (value, limit) in limits.items():
        if len(value) > limit:
            raise SystemExit(
                f'Play {name} for {language} exceeds {limit} characters: {len(value)}'
            )

def sync_play_listing_metadata(token, api_base, upload_api_base, edit_id, metadata_root):
    listings_root = pathlib.Path(metadata_root) / 'listings'
    if not listings_root.is_dir():
        print(f'No Play listing metadata found at {listings_root}; skipping listing sync.')
        return

    image_types = {
        'icon': 'icon',
        'feature-graphic': 'featureGraphic',
        'phone-screenshots': 'phoneScreenshots',
        'seven-inch-screenshots': 'sevenInchScreenshots',
        'ten-inch-screenshots': 'tenInchScreenshots',
    }
    language_count = 0
    image_count = 0

    for language_dir in sorted(path for path in listings_root.iterdir() if path.is_dir()):
        language = language_dir.name
        text_files = [
            language_dir / 'title.txt',
            language_dir / 'short-description.txt',
            language_dir / 'full-description.txt',
        ]
        if any(path.exists() for path in text_files):
            title = read_required_text(text_files[0])
            short_description = read_required_text(text_files[1])
            full_description = read_required_text(text_files[2])
            validate_listing_lengths(language, title, short_description, full_description)
            request_json(
                'PUT',
                api_base + f'/edits/{edit_id}/listings/{urllib.parse.quote(language, safe="")}',
                token=token,
                data={
                    'title': title,
                    'shortDescription': short_description,
                    'fullDescription': full_description,
                },
            )
            language_count += 1
            print(f'Updated Play listing text for {language}.')

        graphics_root = language_dir / 'graphics'
        if not graphics_root.is_dir():
            continue
        for local_dir_name, image_type in image_types.items():
            image_dir = graphics_root / local_dir_name
            if not image_dir.is_dir():
                continue
            image_paths = sorted(
                path for path in image_dir.iterdir()
                if path.is_file() and path.suffix.lower() in ('.png', '.jpg', '.jpeg')
            )
            if not image_paths:
                continue

            image_url = (
                api_base +
                f'/edits/{edit_id}/listings/{urllib.parse.quote(language, safe="")}' +
                f'/{urllib.parse.quote(image_type, safe="")}'
            )
            request_json('DELETE', image_url, token=token)
            for image_path in image_paths:
                upload_url = (
                    upload_api_base +
                    f'/edits/{edit_id}/listings/{urllib.parse.quote(language, safe="")}' +
                    f'/{urllib.parse.quote(image_type, safe="")}?uploadType=media'
                )
                request_json(
                    'POST',
                    upload_url,
                    token=token,
                    data=image_path.read_bytes(),
                    content_type=content_type_for_image(image_path),
                )
                image_count += 1
            print(f'Uploaded {len(image_paths)} Play {image_type} image(s) for {language}.')

    print(f'Play listing metadata sync complete: {language_count} language(s), {image_count} image(s).')

token_resp = request_json('POST', 'https://oauth2.googleapis.com/token', data=urllib.parse.urlencode({
    'grant_type': 'urn:ietf:params:oauth:grant-type:jwt-bearer',
    'assertion': assertion,
}).encode('utf-8'), content_type='application/x-www-form-urlencoded')
token = token_resp['access_token']
base = f'https://androidpublisher.googleapis.com/androidpublisher/v3/applications/{urllib.parse.quote(package_name, safe="")}'
upload_base = f'https://androidpublisher.googleapis.com/upload/androidpublisher/v3/applications/{urllib.parse.quote(package_name, safe="")}'
edit = request_json('POST', base + '/edits', token=token)
edit_id = edit['id']
print(f'Created Google Play edit: {edit_id}')
with open(aab_path, 'rb') as f:
    bundle = f.read()
upload_url = f'{upload_base}/edits/{edit_id}/bundles?uploadType=media'
bundle_resp = request_json('POST', upload_url, token=token, data=bundle, content_type='application/octet-stream')
version_code = str(bundle_resp['versionCode'])
print(f'Uploaded bundle versionCode: {version_code}')
sync_play_listing_metadata(
    token,
    base,
    upload_base,
    edit_id,
    os.environ.get('PLAY_METADATA_ROOT', ''),
)
release = {
    'versionCodes': [version_code],
    'status': release_status,
    'releaseNotes': release_notes,
}
if release_status == 'inProgress':
    if not rollout_fraction.strip():
        raise SystemExit('PLAY_ROLLOUT_FRACTION is required when PLAY_RELEASE_STATUS=inProgress')
    try:
        user_fraction = float(rollout_fraction)
    except ValueError:
        raise SystemExit(f'Invalid PLAY_ROLLOUT_FRACTION: {rollout_fraction!r}')
    if not 0 < user_fraction < 1:
        raise SystemExit('PLAY_ROLLOUT_FRACTION must be greater than 0 and less than 1')
    release['userFraction'] = user_fraction
elif rollout_fraction.strip():
    print(f'Ignoring PLAY_ROLLOUT_FRACTION because release status is {release_status}.')
track_body = {
    'track': track,
    'releases': [release]
}
request_json('PUT', base + f'/edits/{edit_id}/tracks/{urllib.parse.quote(track, safe="")}', token=token, data=track_body)
request_json('POST', base + f'/edits/{edit_id}:commit', token=token)
print(f'Committed Google Play {track} release as {release_status}.')
PY
rm -f "$play_json"
'''
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
