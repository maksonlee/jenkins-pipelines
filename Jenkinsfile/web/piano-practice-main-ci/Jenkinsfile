// Former job name, kept until web/piano-practice/{ci,deploy} have replaced it; the tools live under
// Jenkinsfile/web/piano-practice/. Do not extend this file.
pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '15'))
        copyArtifactPermission('/web/piano-practice-deploy,/web/piano-practice/deploy')
        timeout(time: 25, unit: 'MINUTES')
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                dir('pipeline-source') {
                    checkout scm
                }
                dir('piano-practice') {
                    git branch: 'main',
                            credentialsId: 'piano-practice-github-read',
                            url: 'git@github.com:maksonlee/piano-practice.git'
                    sh '''#!/usr/bin/env bash
set -euo pipefail
test "$(git rev-parse HEAD)" = "$(git rev-parse refs/remotes/origin/main)"
test -z "$(git status --porcelain --untracked-files=all)"
echo "Piano Practice main source: $(git rev-parse HEAD)"
'''
                    script {
                        env.PIANO_REVISION = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    }
                }
            }
        }

        stage('Verify and package') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail
support='pipeline-source/Jenkinsfile/web/piano-practice/ci'
image=$(docker build --quiet "$support")
docker run --rm --init --shm-size=1g --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$WORKSPACE/piano-practice,dst=/app" --workdir /app \
  --env HOME=/tmp --env CI=true --env VITE_PUBLIC_ORIGIN=https://piano.maksonlee.com/ \
  "$image" bash -euo pipefail -c '
    node --version
    npm --version
    npm ci --include=dev
    npx --no-install playwright install chromium
    npm run check
  '

test -d piano-practice/dist && test ! -L piano-practice/dist
mkdir release
docker run --rm --network none --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$WORKSPACE/$support,dst=/tools,readonly" \
  --mount "type=bind,src=$WORKSPACE/piano-practice/dist,dst=/dist,readonly" \
  --mount "type=bind,src=$WORKSPACE/release,dst=/release" \
  "$image" bash -euo pipefail -c '
    node --test /tools/package-release.test.mjs
    node /tools/package-release.mjs /dist /release "$1" "$2" "$3"
  ' _ "$PIANO_REVISION" "$JOB_NAME" "$BUILD_NUMBER"
'''
                archiveArtifacts artifacts: 'release/piano-practice-dist.tar.gz,release/release.json,release/checksums.json', fingerprint: true
            }
        }
    }

    post {
        unsuccessful {
            archiveArtifacts artifacts: 'piano-practice/test-results/e2e/**', allowEmptyArchive: true
        }
        cleanup {
            deleteDir()
        }
    }
}
