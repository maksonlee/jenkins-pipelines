@Library('jenkins-shared-lib') _

// CI for maksonlee/readerplay main: the Node unit tests, then every browser script one at a time against the
// repository's own local server. The container sits on an internal Docker network: it has no route to the internet,
// but it has a network interface, without which Chromium reports itself offline and the pages never show their
// "ready for offline use" state. The checkout is a full clone because the tests read earlier release commits. The optional seven-minute FreeCell deal check and the script that fetches an
// external site are not run.
pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                dir('source') {
                    git branch: 'main', credentialsId: 'vault-github-ssh',
                            url: 'git@github.com:maksonlee/readerplay.git'
                    sh '''#!/bin/bash
set -euo pipefail
test "$(git rev-parse --is-shallow-repository)" = false
echo "readerplay main: $(git rev-parse HEAD)"
'''
                }
            }
        }

        stage('Tests') {
            steps {
                script {
                    def network = "readerplay-ci-${env.BUILD_NUMBER}"
                    sh "docker network create --internal ${network}"
                    try {
                    def args = buildContainer.resourceArgs() + ["--network ${network}", '--init', '--shm-size=1g']
                    docker.image(buildImages.playwright()).inside(args.join(' ')) {
                        sh '''#!/bin/bash
set -euo pipefail
cd source
export HOME=/tmp
READERPLAY_BROWSER=$(ls /ms-playwright/chromium-*/chrome-linux64/chrome | head -n 1)
export READERPLAY_BROWSER
test -x "$READERPLAY_BROWSER"
node --version

echo '== Unit tests'
node --test tests/*.test.cjs

for script in tests/*-browser.cjs; do
  # sudoku-reflow-browser.cjs first reproduces a layout overflow of an old release; that reproduction depends on
  # the Chromium build and does not happen with this image's, so the script is left to local runs.
  if [[ "$script" == tests/sudoku-reflow-browser.cjs ]]; then
    echo "== $script (skipped: depends on the Chromium build)"
    continue
  fi
  echo "== $script"
  node "$script"
done
'''
                    }
                    } finally {
                        sh "docker network rm ${network}"
                    }
                }
            }
        }
    }

    post {
        cleanup {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
