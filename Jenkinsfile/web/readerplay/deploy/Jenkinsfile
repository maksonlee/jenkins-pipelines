@Library('jenkins-shared-lib') _

// Manual deployment of maksonlee/readerplay to its origin: the repository's public/ directory, without a build.
// The tests run in web/readerplay/ci on every push.
staticSiteDeploy(
    site: 'readerplay',
    repo: 'readerplay',
    url: 'https://readerplay.maksonlee.com',
    directory: 'public',
    statusChecks: ['/': 200, '/this-page-does-not-exist': 404],
    sameFiles: [
        '/': 'index.html',
        '/home.js': 'home.js',
        '/home.css': 'home.css',
        '/sw.js': 'sw.js',
        '/sudoku/': 'sudoku/index.html'
    ]
)
