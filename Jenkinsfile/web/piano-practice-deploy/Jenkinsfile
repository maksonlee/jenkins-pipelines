def withOriginCredentials(Closure action) {
    withCredentials([
        sshUserPrivateKey(credentialsId: 'piano-practice-deploy-ssh',
                          keyFileVariable: 'PIANO_DEPLOY_KEY',
                          usernameVariable: 'PIANO_DEPLOY_USER'),
        file(credentialsId: 'piano-practice-deploy-known-hosts', variable: 'PIANO_KNOWN_HOSTS')
    ]) {
        action()
    }
}

def smoke(String origin, String report) {
    withEnv(["SMOKE_ORIGIN=${origin}", "SMOKE_REPORT=${report}"]) {
        sh '''#!/usr/bin/env bash
            set -euo pipefail
            docker run --rm --shm-size=512m --user "$(id -u):$(id -g)" -e HOME=/tmp \
                -v "$PWD/$DEPLOY_TOOLS:/tools:ro" -v "$PWD/$CI_ARTIFACTS:/artifacts:ro" \
                -v "$PWD/$DEPLOY_EVIDENCE/site:/candidate:ro" -v "$PWD/$DEPLOY_EVIDENCE/reports:/reports" \
                -w /tools "$DEPLOY_IMAGE" node smoke.mjs "$SMOKE_ORIGIN" /candidate \
                /artifacts/release.json /artifacts/checksums.json "/reports/$SMOKE_REPORT"
        '''
    }
}

pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        disableConcurrentBuilds()
        disableRestartFromStage()
        skipDefaultCheckout(true)
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        string(name: 'CI_BUILD', defaultValue: '', trim: true, description: 'Successful build number from web/piano-practice-main-ci.')
        choice(name: 'MODE', choices: ['verify-only', 'stage-only', 'activate-production'], description: 'Verify locally, stage at the origin, or activate production.')
        string(name: 'EXPECTED_RELEASE', defaultValue: '', trim: true, description: 'Required for origin staging or activation. Enter the 20-character release ID from the selected CI artifact.')
    }

    environment {
        DEPLOY_TOOLS = 'Jenkinsfile/web/piano-practice-deploy'
        CI_TOOLS = 'Jenkinsfile/web/piano-practice-main-ci'
        CI_ARTIFACTS = 'incoming/release'
        DEPLOY_EVIDENCE = 'deploy-evidence'
    }

    stages {
        stage('Select successful CI artifact') {
            steps {
                deleteDir()
                checkout scm
                script {
                    if (!(params.CI_BUILD ==~ /[1-9][0-9]{0,8}/)) {
                        error('Select a numeric CI build greater than zero.')
                    }
                    if (!(params.MODE in ['verify-only', 'stage-only', 'activate-production'])) {
                        error('Choose a supported deployment mode.')
                    }
                    if (params.MODE != 'verify-only' && !(params.EXPECTED_RELEASE ==~ /[0-9a-f]{20}/)) {
                        error('Enter the selected CI release ID before using the origin.')
                    }
                    env.SELECTED_CI_BUILD = params.CI_BUILD
                    def selected = timeout(time: 2, unit: 'MINUTES') {
                        waitForBuild(runId: "web/piano-practice-main-ci#${env.SELECTED_CI_BUILD}",
                                     propagate: false, propagateAbort: false)
                    }
                    if (selected.result != 'SUCCESS' || selected.number.toString() != env.SELECTED_CI_BUILD) {
                        error('The selected CI build must have result SUCCESS.')
                    }
                    copyArtifacts(projectName: '/web/piano-practice-main-ci',
                                  selector: specific(env.SELECTED_CI_BUILD),
                                  filter: 'release/release.json,release/checksums.json,release/piano-practice-dist.tar.gz',
                                  target: 'incoming',
                                  fingerprintArtifacts: true)
                }
            }
        }

        stage('Validate artifact and test candidate') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        mkdir -p "$DEPLOY_EVIDENCE/reports"
                        release_filter=()
                        if [[ "$MODE" != 'verify-only' ]]; then
                            release_filter=(--expected-release "$EXPECTED_RELEASE")
                        fi
                        python3 "$DEPLOY_TOOLS/release_ops.py" --build "$SELECTED_CI_BUILD" \
                            --artifacts "$CI_ARTIFACTS" --output "$DEPLOY_EVIDENCE/site" "${release_filter[@]}" \
                            > "$DEPLOY_EVIDENCE/candidate.json"
                        cat "$DEPLOY_EVIDENCE/candidate.json"
                        python3 -c 'import uuid; print(uuid.uuid4().hex)' > "$DEPLOY_EVIDENCE/attempt-id"
                    '''
                    script {
                        env.DEPLOY_IMAGE = sh(returnStdout: true, script: '''#!/usr/bin/env bash
                            set -euo pipefail
                            docker build --quiet -f "$CI_TOOLS/Dockerfile" "$CI_TOOLS"
                        ''').trim()
                    }
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
                            -v "$PWD/$DEPLOY_TOOLS:/tools" -w /tools "$DEPLOY_IMAGE" \
                            npm ci --ignore-scripts --no-audit --no-fund
                    '''
                    script { smoke('local', 'local-smoke.json') }
                }
            }
        }

        stage('Stage at the production origin') {
            when { expression { params.MODE in ['stage-only', 'activate-production'] } }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        withOriginCredentials {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                bash "$DEPLOY_TOOLS/origin.sh" stage > "$DEPLOY_EVIDENCE/staged.json"
                                cat "$DEPLOY_EVIDENCE/staged.json"
                            '''
                        }
                    }
                }
            }
        }

        stage('Atomically activate the selected release') {
            when { expression { params.MODE == 'activate-production' } }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        withOriginCredentials {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                touch "$DEPLOY_EVIDENCE/activation-requested"
                                bash "$DEPLOY_TOOLS/origin.sh" activate > "$DEPLOY_EVIDENCE/activation.json"
                                cat "$DEPLOY_EVIDENCE/activation.json"
                            '''
                        }
                    }
                }
            }
        }

        stage('Verify current public release') {
            when { expression { params.MODE == 'activate-production' } }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        smoke('https://piano.maksonlee.com/', 'production-smoke.json')
                        withOriginCredentials {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                bash "$DEPLOY_TOOLS/origin.sh" confirm > "$DEPLOY_EVIDENCE/confirmed.json"
                                cat "$DEPLOY_EVIDENCE/confirmed.json"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        unsuccessful {
            script {
                if (fileExists("${env.DEPLOY_EVIDENCE}/activation-requested")) {
                    timeout(time: 2, unit: 'MINUTES') {
                        withOriginCredentials {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                bash "$DEPLOY_TOOLS/origin.sh" rollback > "$DEPLOY_EVIDENCE/rollback.json"
                                cat "$DEPLOY_EVIDENCE/rollback.json"
                            '''
                        }
                    }
                }
            }
        }
        cleanup {
            archiveArtifacts artifacts: 'deploy-evidence/*.json,deploy-evidence/reports/*.json,deploy-evidence/attempt-id', allowEmptyArchive: true
        }
    }
}
