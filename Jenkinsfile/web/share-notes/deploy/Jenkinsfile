@Library('jenkins-shared-lib') _

// Manual deployment of the maksonlee/share-notes web app to its origin: the Flutter tests, then the web build with
// the repository's own build identity. The browser tests in tool/device/ are not run. The Android app keeps
// flutter/share-notes/{ci,release}.
staticSiteDeploy(
    site: 'share-notes',
    repo: 'share-notes',
    branch: 'master',
    url: 'https://share-notes.maksonlee.com',
    flutterWeb: true,
    statusChecks: ['/': 200, '/help.html': 200, '/privacy.html': 200, '/terms.html': 200, '/api': 404],
    sameFiles: [
        '/': 'index.html',
        '/main.dart.js': 'main.dart.js',
        '/version.json': 'version.json',
        '/flutter_bootstrap.js': 'flutter_bootstrap.js'
    ]
)
