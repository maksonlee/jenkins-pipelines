@Library('jenkins-shared-lib') _

// Manual deployment of the maksonlee/share-notes web app (static files) to its origin.
//
// verify-only runs the Flutter tests, builds the web app from a commit on master with the repository's own build
// identity, and reads what is live. stage-only also unpacks the build beside the site; the site does not change.
// activate-production then asks for approval, copies the live files aside, syncs the release into the live
// directory, checks the public site and syncs the copy back if a check fails. nginx configuration is not managed.
def jsonField(String file, String key) {
    withEnv(["JSON_FILE=${file}", "JSON_KEY=${key}"]) {
        return sh(returnStdout: true, script: '''#!/bin/bash
set -euo pipefail
python3 -c 'import json, os; print(json.load(open(os.environ["JSON_FILE"]))[os.environ["JSON_KEY"]])'
''').trim()
    }
}

pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    }

    parameters {
        string(name: 'GIT_REF', defaultValue: 'master', trim: true,
                description: 'master, or a full commit SHA already on master')
        choice(name: 'MODE', choices: ['verify-only', 'stage-only', 'activate-production'],
                description: 'Test, build and compare only, stage at the origin, or switch production')
        string(name: 'EXPECTED_RELEASE', defaultValue: '', trim: true,
                description: 'Required to stage or activate: the release ID a verify-only run printed for this commit')
    }

    environment {
        HELPER = 'pipeline-source/resources/web/static_site_release.py'
        ORIGIN = 'ubuntu@app.maksonlee.com'
        SITE = 'https://share-notes.maksonlee.com'
        EVIDENCE = 'deploy-evidence'
        FLUTTER_CACHE_ROOT = '/home/administrator/jenkins/flutter-cache'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    if (!(params.GIT_REF ==~ /master|[0-9a-f]{40}/)) {
                        error('GIT_REF must be master or a full commit SHA')
                    }
                    if (!(params.MODE in ['verify-only', 'stage-only', 'activate-production'])) {
                        error('Choose a supported mode')
                    }
                    if (params.MODE != 'verify-only' && !(params.EXPECTED_RELEASE ==~ /[0-9a-f]{12}-[0-9a-f]{12}/)) {
                        error('Enter the release ID from a verify-only run before using the origin')
                    }
                }
                deleteDir()
                dir('pipeline-source') {
                    checkout scm
                }
                dir('source') {
                    git branch: 'master', credentialsId: 'vault-github-ssh',
                            url: 'git@github.com:maksonlee/share-notes.git'
                    withEnv(["GIT_REF=${params.GIT_REF}"]) {
                        sh '''#!/bin/bash
set -euo pipefail
if [[ "$GIT_REF" == master ]]; then
  commit=$(git rev-parse --verify 'refs/remotes/origin/master^{commit}')
else
  commit=$(git rev-parse --verify "$GIT_REF^{commit}")
  git merge-base --is-ancestor "$commit" refs/remotes/origin/master
fi
git checkout --quiet --detach "$commit"
test -z "$(git status --porcelain)"
printf '%s\\n' "$commit" > ../release-commit.txt
python3 -I - > ../flutter-version.txt <<'PY'
import json, re
version = json.load(open('.fvmrc'))['flutter']
if not re.fullmatch(r'[0-9]+\\.[0-9]+\\.[0-9]+', version):
    raise SystemExit('Unexpected Flutter version in .fvmrc')
print(version)
PY
'''
                    }
                }
                script {
                    env.RELEASE_COMMIT = readFile('release-commit.txt').trim()
                    env.FLUTTER_VERSION = readFile('flutter-version.txt').trim()
                    env.DEPLOY_MODE = params.MODE
                    env.FLUTTER_IMAGE = buildImages.flutter()
                    env.BUILD_CONTAINER_RESOURCE_ARGS = buildContainer.resourceArgs().join(' ')
                }
            }
        }

        stage('Test and build the web app') {
            steps {
                timeout(time: 40, unit: 'MINUTES') {
                    sh '''#!/bin/bash
set -euo pipefail
mkdir -p "$EVIDENCE" "$FLUTTER_CACHE_ROOT/fvm" "$FLUTTER_CACHE_ROOT/pub-cache"
# The repository's helper decides the build identity shown in About; only its arguments are taken from it.
python3 -I - "$WORKSPACE/source" > flutter-build-arguments <<'PY'
import sys
from pathlib import Path
root = Path(sys.argv[1])
sys.path.insert(0, str(root / 'tool'))
import build_flutter
command = build_flutter.build_command(root, ['web', '--release'])
if command[:3] != ['fvm', 'flutter', 'build'] or any('-modified' in argument for argument in command):
    raise SystemExit('Unexpected web build command')
sys.stdout.write('\\0'.join(command[2:]) + '\\0')
PY
test -z "$(git -C source status --porcelain)"
docker run --rm $BUILD_CONTAINER_RESOURCE_ARGS -u "$(id -u):$(id -g)" \\
  -e HOME=/home/ubuntu -e FVM_CACHE_PATH=/home/ubuntu/fvm -e PUB_CACHE=/home/ubuntu/pub-cache \\
  -e FLUTTER_VERSION \\
  -v "$FLUTTER_CACHE_ROOT/fvm:/home/ubuntu/fvm" -v "$FLUTTER_CACHE_ROOT/pub-cache:/home/ubuntu/pub-cache" \\
  -v "$WORKSPACE/source:/workspace" -v "$WORKSPACE/flutter-build-arguments:/flutter-build-arguments:ro" \\
  -w /workspace "$FLUTTER_IMAGE" bash -lc '
    set -euo pipefail
    flutter="/home/ubuntu/fvm/versions/$FLUTTER_VERSION/bin/flutter"
    fvm install "$FLUTTER_VERSION"
    "$flutter" config --no-analytics
    "$flutter" pub get
    "$flutter" test --no-pub
    xargs -0 "$flutter" < /flutter-build-arguments
  '
python3 "$HELPER" share-notes package source/build/web "$RELEASE_COMMIT" "$EVIDENCE" > /dev/null
cat "$EVIDENCE/candidate.json"
ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=12 "$ORIGIN" \\
  'sudo -n python3 - share-notes status' < "$HELPER" > "$EVIDENCE/origin-status.json"
python3 - "$EVIDENCE" "$DEPLOY_MODE" "${EXPECTED_RELEASE:-}" <<'PY'
import json, sys
evidence, mode, expected = sys.argv[1:]
candidate = json.load(open(f'{evidence}/candidate.json'))
status = json.load(open(f'{evidence}/origin-status.json'))
same = candidate['releaseId'].endswith('-' + status['liveContent'])
print(f"Candidate {candidate['releaseId']} (version {candidate['version']}) from {candidate['commit']}; "
      f"live version: {status['liveVersion']}; live files identical to this build: {same}; "
      f"already staged: {candidate['releaseId'] in status['staged']}")
if mode != 'verify-only' and expected != candidate['releaseId']:
    raise SystemExit('The built release differs from EXPECTED_RELEASE; run verify-only again')
PY
'''
                    script {
                        env.RELEASE_ID = jsonField("${env.EVIDENCE}/candidate.json", 'releaseId')
                        env.RELEASE_VERSION = jsonField("${env.EVIDENCE}/candidate.json", 'version')
                        env.ARCHIVE_SHA256 = jsonField("${env.EVIDENCE}/candidate.json", 'archiveSha256')
                        env.LIVE_VERSION = jsonField("${env.EVIDENCE}/origin-status.json", 'liveVersion')
                        if (!(env.RELEASE_ID ==~ /[0-9a-f]{12}-[0-9a-f]{12}/) || !(env.ARCHIVE_SHA256 ==~ /[0-9a-f]{64}/) ||
                                !(env.RELEASE_VERSION ==~ /[0-9A-Za-z.+-]{1,40}/) || !(env.LIVE_VERSION ==~ /[0-9A-Za-z.+-]{1,40}/)) {
                            error('Unexpected release identifiers')
                        }
                    }
                }
            }
        }

        stage('Stage at the origin') {
            when { expression { params.MODE in ['stage-only', 'activate-production'] } }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    sh '''#!/bin/bash
set -euo pipefail
ssh_origin=(ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=12 "$ORIGIN")
remote="/tmp/share-notes-web-$RELEASE_ID.tar.gz"
scp -q -o BatchMode=yes -o StrictHostKeyChecking=yes "$EVIDENCE/site-release.tar.gz" "$ORIGIN:$remote"
trap '"${ssh_origin[@]}" "rm -f $remote"' EXIT
"${ssh_origin[@]}" "sudo -n python3 - share-notes stage $RELEASE_ID $RELEASE_COMMIT $remote $ARCHIVE_SHA256" \\
  < "$HELPER" > "$EVIDENCE/staged.json"
cat "$EVIDENCE/staged.json"
'''
                }
            }
        }

        stage('Approve the production switch') {
            when { expression { params.MODE == 'activate-production' } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Replace ${env.SITE} (now ${env.LIVE_VERSION}) with version ${env.RELEASE_VERSION}, " +
                            "release ${env.RELEASE_ID} (commit ${env.RELEASE_COMMIT})? A failed public check restores the previous files."
                }
            }
        }

        stage('Switch production and check it') {
            when { expression { params.MODE == 'activate-production' } }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    sh '''#!/bin/bash
set -euo pipefail
ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=12 "$ORIGIN" \\
  "sudo -n python3 - share-notes activate $RELEASE_ID $RELEASE_COMMIT" < "$HELPER" > "$EVIDENCE/activation.json"
cat "$EVIDENCE/activation.json"

: > "$EVIDENCE/public-checks.txt"
check() {  # path, expected status
  local status
  status=$(curl --silent --show-error --max-time 30 --output /dev/null --write-out '%{http_code}' "$SITE$1")
  printf '%s %s\\n' "$status" "$1" >> "$EVIDENCE/public-checks.txt"
  [[ "$status" == "$2" ]] || { echo "Unexpected HTTP $status for $1" >&2; return 1; }
}
same_file() {  # path, manifest path: the public bytes are the built bytes
  local expected actual
  expected=$(awk -v path="$2" '$2 == path { print $1 }' "$EVIDENCE/manifest.sha256")
  actual=$(curl --fail --silent --show-error --max-time 60 "$SITE$1" | sha256sum | cut -d' ' -f1)
  printf '%s %s\\n' "$actual" "$1" >> "$EVIDENCE/public-checks.txt"
  [[ -n "$expected" && "$actual" == "$expected" ]] || { echo "$1 is not the built file" >&2; return 1; }
}
for page in / /help.html /privacy.html /terms.html; do check "$page" 200; done
check /api 404
same_file / index.html
same_file /main.dart.js main.dart.js
same_file /version.json version.json
same_file /flutter_bootstrap.js flutter_bootstrap.js
cat "$EVIDENCE/public-checks.txt"
'''
                }
            }
        }
    }

    post {
        unsuccessful {
            script {
                if (fileExists("${env.EVIDENCE}/activation.json") &&
                        jsonField("${env.EVIDENCE}/activation.json", 'state') == 'activated') {
                    sh '''#!/bin/bash
set -euo pipefail
ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=12 "$ORIGIN" \\
  "sudo -n python3 - share-notes rollback $RELEASE_ID $RELEASE_COMMIT" < "$HELPER" > "$EVIDENCE/rollback.json"
cat "$EVIDENCE/rollback.json"
'''
                }
            }
        }
        always {
            archiveArtifacts artifacts: 'deploy-evidence/*.json,deploy-evidence/*.txt,deploy-evidence/manifest.sha256',
                    allowEmptyArchive: true
        }
        cleanup {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
