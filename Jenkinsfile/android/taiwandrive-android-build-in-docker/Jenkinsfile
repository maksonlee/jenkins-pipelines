@Library('jenkins-shared-lib') _

pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'GIT_REF', defaultValue: 'main', description: 'main or a full commit SHA already contained in origin/main')
        booleanParam(name: 'PUBLISH_TO_PLAY', defaultValue: false, description: 'Upload the verified AAB to the selected Google Play test track after approval')
        choice(name: 'PLAY_TRACK', choices: ['alpha', 'internal'], description: 'Google Play API track ID; alpha is Closed testing - Alpha')
        choice(name: 'PLAY_RELEASE_STATUS', choices: ['draft', 'completed'], description: 'A draft app requires draft; use completed after Google has published the first test release')
    }

    stages {
        stage('Resolve release') {
            steps {
                script {
                    def gitRef = params.GIT_REF?.trim()
                    if (!gitRef || (gitRef != 'main' && !(gitRef ==~ /^[0-9a-fA-F]{40}$/))) {
                        error 'GIT_REF must be main or a full 40-character commit SHA'
                    }
                    env.GIT_REF = gitRef
                }
            }
        }

        stage('Fetch code') {
            steps {
                deleteDir()
                checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.GIT_REF]],
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [],
                        userRemoteConfigs: [[
                                credentialsId: 'vault-github-ssh',
                                url: 'git@github.com:maksonlee/taiwandrive.git'
                        ]]
                ])
                sh '''#!/bin/bash
set -euo pipefail
release_commit=$(git rev-parse HEAD)
git rev-parse --verify 'refs/remotes/origin/main^{commit}' >/dev/null
if ! git merge-base --is-ancestor "$release_commit" refs/remotes/origin/main; then
  echo 'Release commit is not contained in origin/main; refusing to expose signing credentials.' >&2
  exit 1
fi
# Release builds download their first signed offline pack; none may be bundled.
if [ -e app/src/main/assets/offline_pack.zip ]; then
  echo 'A bundled offline pack is not allowed in a release checkout.' >&2
  exit 1
fi
for locale in en-US zh-TW; do
  test -s "app/src/main/play/release-notes/$locale/default.txt"
done
sed -nE 's/^[[:space:]]*versionCode = ([0-9]+)$/\\1/p' app/build.gradle.kts > .release-version-code
sed -nE 's/^[[:space:]]*versionName = "([^"]+)"$/\\1/p' app/build.gradle.kts > .release-version-name
test "$(wc -l < .release-version-code)" -eq 1
test "$(wc -l < .release-version-name)" -eq 1
echo "$release_commit" > .release-commit
echo "CHECKED_OUT_COMMIT=$release_commit"
echo "CHECKED_OUT_SUBJECT=$(git log -1 --pretty=%s)"
'''
                script {
                    env.RELEASE_COMMIT = readFile('.release-commit').trim()
                    env.RELEASE_VERSION_CODE = readFile('.release-version-code').trim()
                    env.RELEASE_VERSION_NAME = readFile('.release-version-name').trim()
                    echo "Building ${env.RELEASE_COMMIT} as Android ${env.RELEASE_VERSION_NAME} (${env.RELEASE_VERSION_CODE})"
                }
            }
        }

        stage('Test, lint, build & sign AAB') {
            steps {
                script {
                    gradleRelease(':app:bundleRelease', androidReleaseConfig([
                            extraArgs: [':engine:test', ':pack:test', ':app:testDebugUnitTest', ':app:lintDebug']
                    ]))
                }
            }
        }

        stage('Verify AAB') {
            steps {
                withVault([vaultSecrets: [[
                    path: 'secret/jenkins/mobile/app/com.maksonlee.taiwandrive',
                    engineVersion: 2,
                    secretValues: [[
                        envVar: 'EXPECTED_UPLOAD_CERT_SHA256',
                        vaultKey: 'certificate_sha256'
                    ]]
                ]]]) {
                    sh '''#!/bin/bash
set -euo pipefail
export LC_ALL=C
release_dir=app/build/outputs/bundle/release
aab=$release_dir/app-release.aab
test -s "$aab"
signature_report=$release_dir/signature-verification.txt
if ! jarsigner -verify "$aab" > "$signature_report" 2>&1; then
  cat "$signature_report" >&2
  exit 1
fi
grep -q 'jar verified.' "$signature_report"
if grep -qi 'unsigned entries' "$signature_report"; then
  cat "$signature_report" >&2
  echo 'AAB contains unsigned entries.' >&2
  exit 1
fi

expected_signer=$(printf %s "${EXPECTED_UPLOAD_CERT_SHA256:?ERROR: expected upload certificate SHA-256 is unset}" \
  | tr -d ':[:space:]' | tr '[:lower:]' '[:upper:]')
actual_signer=$(keytool -printcert -jarfile "$aab" \
  | awk -F': ' '$1 ~ /^[[:space:]]*SHA256$/ { print $2; exit }' \
  | tr -d ':[:space:]' | tr '[:lower:]' '[:upper:]')
if [[ ! "$expected_signer" =~ ^[0-9A-F]{64}$ ]] || [[ ! "$actual_signer" =~ ^[0-9A-F]{64}$ ]]; then
  echo 'Could not compare exactly one upload certificate SHA-256 fingerprint.' >&2
  exit 1
fi
if [ "$actual_signer" != "$expected_signer" ]; then
  echo 'AAB signer does not match the approved shared upload certificate.' >&2
  exit 1
fi
echo 'AAB signer matches the approved shared upload certificate.'

if unzip -Z1 "$aab" | grep -q 'offline_pack\\.zip$'; then
  echo 'AAB must not bundle an offline pack.' >&2
  exit 1
fi
sha256sum "$aab" | sed 's#  .*/#  #' > "$aab.sha256"
cat "$aab.sha256"
'''
                }
                stash name: 'android-release-aab', includes: 'app/build/outputs/bundle/release/*.aab,app/build/outputs/bundle/release/*.sha256,app/build/outputs/bundle/release/signature-verification.txt'
                archiveArtifacts artifacts: 'app/build/outputs/bundle/release/*.aab,app/build/outputs/bundle/release/*.sha256,app/build/outputs/bundle/release/signature-verification.txt', fingerprint: true
            }
        }

        stage('Approve Google Play test upload') {
            when { expression { params.PUBLISH_TO_PLAY } }
            steps {
                input message: "Upload ${env.RELEASE_VERSION_NAME} (${env.RELEASE_VERSION_CODE}) at ${env.RELEASE_COMMIT} to Google Play ${params.PLAY_TRACK} as ${params.PLAY_RELEASE_STATUS}?"
            }
        }

        stage('Publish to Google Play test track') {
            when { expression { params.PUBLISH_TO_PLAY } }
            steps {
                script {
                    unstash 'android-release-aab'
                    sh '''#!/bin/bash
set -euo pipefail
release_dir=app/build/outputs/bundle/release
(cd "$release_dir" && sha256sum -c app-release.aab.sha256)

# GPP uploads every matching AAB in artifactDir. Start with an empty
# publication directory and stage only the artifact verified above.
publication_dir=app/build/outputs/play-publication
rm -rf -- "$publication_dir"
mkdir -p "$publication_dir"
install -m 0644 "$release_dir/app-release.aab" "$publication_dir/app-release.aab"
cmp "$release_dir/app-release.aab" "$publication_dir/app-release.aab"
'''
                    gradleRelease(':app:publishReleaseBundle', androidReleaseConfig([
                            playServiceVaultPath: 'secret/jenkins/mobile/shared/play-service',
                            playJsonPath: '/tmp/taiwandrive-play-service.json',
                            track: params.PLAY_TRACK,
                            extraArgs: ['--artifact-dir=app/build/outputs/play-publication'],
                            extraProps: ['play.releaseStatus': params.PLAY_RELEASE_STATUS]
                    ]))
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}

def androidReleaseConfig(Map overrides = [:]) {
    return [
            // Store listings are maintained separately; never let the shared
            // helper auto-upgrade publishReleaseBundle to publishReleaseApps.
            publishPlayListings: false,
            keystoreVaultPath: 'secret/jenkins/mobile/app/com.maksonlee.taiwandrive',
            jksPath: '/tmp/taiwandrive-upload.jks',
            // The build reads SIGNING_* only, keeping passwords off the Gradle command line.
            passSigningProperties: false,
            maxWorkers: 1
    ] + overrides
}
