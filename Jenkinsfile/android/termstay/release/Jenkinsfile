@Library('jenkins-shared-lib') _

// Google Play release of the Android client of maksonlee/termstay (com.maksonlee.readyterm).
//
// The repository's own tool/build-android.ps1 builds, signs and publishes; this job only runs it from a clean
// checkout of a commit on main. `-Release -OutputDirectory dist` builds the bundle signed with the upload key, the
// agent verifies it, and only with PUBLISH_TO_PLAY and after a manual approval `-Publish -Bundle` sends that same
// file. The script reads its keys from Vault itself with the vault CLI, so the container gets the agent's Vault
// token and a private settings file kept on the agent (the Vault address and the two KV paths); neither is in
// this repository.
pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '20'))
    }

    parameters {
        string(name: 'GIT_REF', defaultValue: 'main', trim: true,
                description: 'main, or a full commit SHA already on main')
        booleanParam(name: 'PUBLISH_TO_PLAY', defaultValue: false,
                description: 'Send the bundle after the manual approval; unchecked only builds, signs and verifies')
        choice(name: 'TRACKS', choices: ['alpha', 'internal-and-alpha'],
                description: 'alpha is closed testing; internal-and-alpha sends to internal testing first')
    }

    environment {
        PACKAGE = 'com.maksonlee.readyterm'
        CACHE = '/home/administrator/jenkins/termstay-cache'
        VAULT_CLI = '/home/administrator/jenkins/veil-test-inputs/vault-2.1.0'
        VAULT_TOKEN_FILE = '/home/administrator/.vault-token'
    }

    stages {
        stage('Build and verify') {
            agent { label 'ssh-agent-with-docker' }
            stages {
                stage('Checkout') {
                    steps {
                        script {
                            if (!(params.TRACKS in ['alpha', 'internal-and-alpha'])) {
                                error('Choose supported tracks')
                            }
                        }
                        deleteDir()
                        dir('pipeline-source') {
                            checkout scm
                        }
                        script {
                            // A complete clone: the build number counts commits.
                            env.RELEASE_COMMIT = checkoutReleaseCommit(repo: 'termstay', gitRef: params.GIT_REF)
                        }
                        sh '''#!/bin/bash
set -euo pipefail
mkdir -p source/.toolchains "$CACHE/toolchains"
test -s "$CACHE/release.env" && test -x "$VAULT_CLI" && test -s "$VAULT_TOKEN_FILE"
'''
                        script {
                            env.RELEASE_IMAGE = sh(returnStdout: true,
                                    script: 'docker build --quiet pipeline-source/Jenkinsfile/android/termstay/ci').trim()
                            env.RELEASE_CONTAINER_ARGS = (buildContainer.resourceArgs() + [
                                    "--mount type=bind,src=${env.CACHE}/toolchains,dst=${pwd()}/source/.toolchains",
                                    "--mount type=bind,src=${env.VAULT_CLI},dst=/usr/local/bin/vault,readonly",
                                    "--mount type=bind,src=${env.VAULT_TOKEN_FILE},dst=/tmp/.vault-token,readonly",
                                    "--env-file ${env.CACHE}/release.env",
                                    '--env HOME=/tmp'
                            ]).join(' ')
                        }
                    }
                }

                stage('Build the signed bundle') {
                    options { timeout(time: 120, unit: 'MINUTES') }
                    steps {
                        script {
                            docker.image(env.RELEASE_IMAGE).inside(env.RELEASE_CONTAINER_ARGS) {
                                dir('source') {
                                    sh '''#!/bin/bash
set -euo pipefail
tool/setup-build-environment.sh
./.toolchains/powershell/current/pwsh -NoLogo -NoProfile -NonInteractive -File tool/build-android.ps1 -Release -OutputDirectory dist
'''
                                }
                            }
                        }
                    }
                }

                stage('Verify the bundle') {
                    options { timeout(time: 20, unit: 'MINUTES') }
                    steps {
                        script {
                            sh '''#!/bin/bash
set -euo pipefail
shopt -s nullglob
bundles=(source/dist/termstay-android-*.aab)
(( ${#bundles[@]} == 1 )) || { echo 'Expected exactly one release bundle in dist' >&2; exit 1; }
name=$(basename "${bundles[0]}")
[[ "$name" =~ ^termstay-android-[0-9A-Za-z.]+-[0-9]+\\.aab$ ]] || { echo 'Unexpected bundle name' >&2; exit 1; }
# The script's own digest of the bundle must still describe the file.
(cd source/dist && sha256sum --check --status "$name.sha256")
mkdir release
cp "${bundles[0]}" "release/$name"
printf '%s\\n' "$name" > bundle-name.txt
'''
                            env.BUNDLE_NAME = readFile('bundle-name.txt').trim()
                            if (!(env.BUNDLE_NAME ==~ /termstay-android-[0-9A-Za-z.]+-[0-9]+\.aab/)) {
                                error('Unexpected bundle name')
                            }
                            def bundle = androidBundle.verify(aab: "release/${env.BUNDLE_NAME}", packageName: env.PACKAGE)
                            env.RELEASE_VERSION = "${bundle.versionName} (${bundle.versionCode})"
                            env.RELEASE_SIGNER_SHA256 = bundle.signerSha256
                            env.RELEASE_AAB_SHA256 = bundle.sha256
                            if (!(env.RELEASE_VERSION ==~ /[0-9A-Za-z._-]{1,40} \([0-9]{1,10}\)/)) {
                                error('Unexpected release version')
                            }
                            currentBuild.description = "termstay ${env.RELEASE_VERSION} ${env.RELEASE_COMMIT.take(12)}"
                            archiveArtifacts artifacts: 'release/*', fingerprint: true
                        }
                    }
                }
            }
        }

        stage('Approve Google Play upload') {
            when { expression { params.PUBLISH_TO_PLAY } }
            options { timeout(time: 60, unit: 'MINUTES') }
            steps {
                input message: "Send ${env.PACKAGE} ${env.RELEASE_VERSION} from ${env.RELEASE_COMMIT}, AAB SHA-256 " +
                        "${env.RELEASE_AAB_SHA256}, signed by certificate SHA-256 ${env.RELEASE_SIGNER_SHA256}, to Google " +
                        "Play ${params.TRACKS} with this commit's release notes? The phone tests are not run by this job."
            }
        }

        stage('Publish to Google Play') {
            agent { label 'ssh-agent-with-docker' }
            when { beforeAgent true; expression { params.PUBLISH_TO_PLAY } }
            options { timeout(time: 30, unit: 'MINUTES') }
            steps {
                script {
                    docker.image(env.RELEASE_IMAGE).inside(env.RELEASE_CONTAINER_ARGS) {
                        dir('source') {
                            withEnv(["TRACKS=${params.TRACKS}"]) {
                                sh '''#!/bin/bash
set -euo pipefail
test "$(sha256sum "dist/$BUNDLE_NAME" | cut -d' ' -f1)" = "$RELEASE_AAB_SHA256"
./.toolchains/powershell/current/pwsh -NoLogo -NoProfile -NonInteractive -File tool/build-android.ps1 \\
  -Publish -Bundle "dist/$BUNDLE_NAME" -Tracks "$TRACKS"
'''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        cleanup {
            node('ssh-agent-with-docker') {
                cleanWs(deleteDirs: true, notFailBuild: true)
            }
        }
    }
}
