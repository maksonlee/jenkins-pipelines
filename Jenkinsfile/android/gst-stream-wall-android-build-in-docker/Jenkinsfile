@Library('jenkins-shared-lib') _

pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'GIT_REF', defaultValue: 'main', description: 'main or a full commit SHA already contained in origin/main')
        string(name: 'VERSION_CODE', defaultValue: '22', description: 'Monotonically increasing Google Play version code')
        string(name: 'VERSION_NAME', defaultValue: '0.1.0-alpha.22', description: 'User-visible Android version')
        booleanParam(name: 'PUBLISH_TO_PLAY', defaultValue: false, description: 'Upload an AAB to the selected Google Play test track after approval')
        booleanParam(name: 'PROMOTE_EXISTING_TO_PLAY', defaultValue: false, description: 'Promote an existing version code from Internal to the selected track without uploading an AAB')
        booleanParam(name: 'PUBLISH_LISTING_TO_PLAY', defaultValue: false, description: 'Update Play Store listing metadata only; does not upload an AAB or alter a release track')
        booleanParam(name: 'CORRESPONDING_SOURCE_READY', defaultValue: false, description: 'Confirm the exact application/GStreamer corresponding source and relink material are retained and recipient-accessible')
        booleanParam(name: 'ALPHA22_BUILD43_OWNER_EXCEPTION', defaultValue: false, description: 'Owner-authorized alpha.22 publication of the exact verified build 43 AAB while additional formal qualification remains incomplete')
        choice(name: 'PLAY_TRACK', choices: ['alpha', 'internal'], description: 'Google Play API track ID; alpha is Closed testing - Alpha')
        choice(name: 'PLAY_RELEASE_STATUS', choices: ['draft', 'completed'], description: 'A draft app requires draft; use completed after Google has published the first test release')
    }

    stages {
        stage('Resolve release') {
            steps {
                script {
                    def gitRef = params.GIT_REF?.trim()
                    def versionCode = params.VERSION_CODE?.trim()
                    def versionName = params.VERSION_NAME?.trim()
                    if (!gitRef || (gitRef != 'main' && !(gitRef ==~ /^[0-9a-fA-F]{40}$/))) {
                        error 'GIT_REF must be main or a full 40-character commit SHA'
                    }
                    if (!versionCode || !(versionCode ==~ /^[0-9]+$/) ||
                            versionCode.toLong() < 1 || versionCode.toLong() > 2100000000L) {
                        error "VERSION_CODE must be between 1 and 2100000000: ${versionCode}"
                    }
                    if (!versionName || !(versionName ==~ /^[0-9A-Za-z][0-9A-Za-z.+-]{0,49}$/)) {
                        error "Invalid VERSION_NAME: ${versionName}"
                    }
                    def playActions = [
                            params.PUBLISH_TO_PLAY,
                            params.PROMOTE_EXISTING_TO_PLAY,
                            params.PUBLISH_LISTING_TO_PLAY
                    ].count { it }
                    if (playActions > 1) {
                        error 'PUBLISH_TO_PLAY, PROMOTE_EXISTING_TO_PLAY, and PUBLISH_LISTING_TO_PLAY are mutually exclusive'
                    }
                    if (params.PROMOTE_EXISTING_TO_PLAY && params.PLAY_TRACK == 'internal') {
                        error 'PROMOTE_EXISTING_TO_PLAY requires PLAY_TRACK=alpha'
                    }
                    // The owner explicitly authorized only this engineering-preview
                    // artifact without the additional formal qualification records.
                    // This exception neither asserts source readiness nor applies to
                    // another artifact, version, track, or publication operation.
                    def reuseBuild43 = params.ALPHA22_BUILD43_OWNER_EXCEPTION
                    if (reuseBuild43 && (
                            gitRef != '9d63d4820e29ccf02b0aea74668d1ad9b28f21a7' ||
                            versionCode != '22' || versionName != '0.1.0-alpha.22' ||
                            !params.PUBLISH_TO_PLAY || params.PROMOTE_EXISTING_TO_PLAY ||
                            params.PUBLISH_LISTING_TO_PLAY || params.CORRESPONDING_SOURCE_READY ||
                            params.PLAY_TRACK != 'alpha' || params.PLAY_RELEASE_STATUS != 'completed')) {
                        error 'The build 43 owner exception is restricted to the exact alpha.22 AAB, alpha/completed, and CORRESPONDING_SOURCE_READY=false'
                    }
                    if ((params.PUBLISH_TO_PLAY || params.PROMOTE_EXISTING_TO_PLAY) &&
                            !params.CORRESPONDING_SOURCE_READY && !reuseBuild43) {
                        error 'Google Play distribution requires CORRESPONDING_SOURCE_READY=true'
                    }
                    env.GIT_REF = gitRef
                    env.RELEASE_VERSION_CODE = versionCode
                    env.RELEASE_VERSION_NAME = versionName
                    env.RELEASE_APPLICATION_ID = 'com.maksonlee.gststreamwall'
                    env.RELEASE_MIN_SDK = '26'
                    env.RELEASE_TARGET_SDK = '37'
                    env.REUSE_AAB_BUILD43 = reuseBuild43 ? 'true' : 'false'
                    env.RELEASE_EXPECTED_AAB_SHA256 = reuseBuild43 ?
                            '2704ca271623fdfc26815d0068b7d03f27a8c4504fb9c84f94d46b034e1e8a6f' : ''
                    env.SKIP_AAB_BUILD = (
                            params.PUBLISH_LISTING_TO_PLAY || params.PROMOTE_EXISTING_TO_PLAY || reuseBuild43
                    ) ? 'true' : 'false'
                    if (params.PUBLISH_LISTING_TO_PLAY) {
                        echo "Updating Play Store listings from ${env.GIT_REF}; no AAB or release track will be changed"
                    } else if (params.PROMOTE_EXISTING_TO_PLAY) {
                        echo "Promoting Android version code ${env.RELEASE_VERSION_CODE} from internal to ${params.PLAY_TRACK} as ${params.PLAY_RELEASE_STATUS}; no AAB will be uploaded"
                    } else if (reuseBuild43) {
                        echo 'Reusing the exact verified Jenkins build 43 alpha.22 AAB; owner-authorized engineering-preview exception, corresponding-source readiness remains false and additional formal qualification remains incomplete'
                    } else {
                        echo "Building ${env.GIT_REF} as Android ${env.RELEASE_VERSION_NAME} (${env.RELEASE_VERSION_CODE})"
                    }
                }
            }
        }

        stage('Fetch code') {
            steps {
                deleteDir()
                checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.GIT_REF]],
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [],
                        userRemoteConfigs: [[
                                credentialsId: 'vault-github-ssh',
                                url: 'git@github.com:maksonlee/gst-stream-wall.git'
                        ]]
                ])
                script {
                    env.RELEASE_COMMIT = sh(
                            script: 'git rev-parse HEAD',
                            returnStdout: true
                    ).trim()
                    env.RELEASE_SUBJECT = sh(
                            script: 'git log -1 --pretty=%s',
                            returnStdout: true
                    ).trim()
                }
                sh '''#!/bin/bash
set -euo pipefail
git rev-parse --verify 'refs/remotes/origin/main^{commit}' >/dev/null
if ! git merge-base --is-ancestor "$RELEASE_COMMIT" refs/remotes/origin/main; then
  echo 'Release commit is not contained in origin/main; refusing to expose signing credentials.' >&2
  exit 1
fi
echo "CHECKED_OUT_COMMIT=$RELEASE_COMMIT"
echo "CHECKED_OUT_SUBJECT=$RELEASE_SUBJECT"
'''
            }
        }

        stage('Validate release inputs') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
python3 scripts/validate-play-metadata.py
if [[ "${PUBLISH_LISTING_TO_PLAY:-false}" == true ]]; then
  python3 scripts/check-release-consistency.py
else
  python3 scripts/check-release-consistency.py --require-tag android
fi
test -x scripts/ensure-android-rust-toolchain.sh

android_sdk=/home/administrator/jenkins/android-cache/flutter-android-sdk
gstreamer_sdk=/home/administrator/.cache/gst-stream-wall/gstreamer-android-1.28.8
test -f "$android_sdk/platforms/android-37.0/android.jar"
test -x "$android_sdk/ndk/28.2.13676358/ndk-build"
test -x "$android_sdk/cmake/3.22.1/bin/cmake"
test -f "$gstreamer_sdk/arm64/share/gst-android/ndk-build/gstreamer-1.0.mk"

install -d \
  /home/administrator/jenkins/android-cache/rust/cargo
'''
            }
        }

        stage('Test, lint, build & sign AAB') {
            when { expression { env.SKIP_AAB_BUILD != 'true' } }
            steps {
                script {
                    gradleRelease(':app:bundleRelease', androidReleaseConfig([
                            extraArgs: [':app:testDebugUnitTest', ':app:lintDebug'],
                            extraProps: [
                                    'release.versionCode': env.RELEASE_VERSION_CODE,
                                    'release.versionName': env.RELEASE_VERSION_NAME
                            ]
                    ]))
                }
            }
        }

        stage('Restore verified alpha.22 build 43 AAB') {
            when { expression { env.REUSE_AAB_BUILD43 == 'true' } }
            steps {
                sh '''#!/bin/bash
set -euo pipefail
release_dir=apps/android/app/build/outputs/bundle/release
retained_root=/home/administrator/jenkins/android-cache/gst-stream-wall/alpha22-build43
retained_dir=$retained_root/$release_dir
test -s "$retained_dir/app-release.aab"
test -s "$retained_dir/release-provenance.json"
test -s "$retained_root/owner-release-scope-decision.json"
mkdir -p "$release_dir"
cp -a "$retained_dir/." "$release_dir/"
cp -a "$retained_root/owner-release-scope-decision.json" "$release_dir/"
printf '%s  %s\n' "$RELEASE_EXPECTED_AAB_SHA256" "$release_dir/app-release.aab" | sha256sum -c -
sha256sum -c "$release_dir/app-release.aab.sha256"
python3 scripts/check-release-consistency.py --require-tag android \
  --provenance "$release_dir/release-provenance.json" \
  --artifact "$release_dir/app-release.aab"
python3 - "$release_dir/owner-release-scope-decision.json" <<'PY'
import json
import sys
from pathlib import Path

decision = json.loads(Path(sys.argv[1]).read_text())
expected = {
    "schema": "org.gststreamwall.engineering-preview-release-scope-exception/v1",
    "application_id": "com.maksonlee.gststreamwall",
    "version_code": 22,
    "version_name": "0.1.0-alpha.22",
    "source_commit": "9d63d4820e29ccf02b0aea74668d1ad9b28f21a7",
    "annotated_tag": "android-v0.1.0-alpha.22",
    "source_jenkins_build": 43,
    "aab_sha256": "2704ca271623fdfc26815d0068b7d03f27a8c4504fb9c84f94d46b034e1e8a6f",
    "track": "alpha",
    "release_status": "completed",
    "listing_publication": False,
    "rebuild_permitted": False,
    "corresponding_source_ready": False,
    "formal_qualification_evidence_complete": False,
    "qualification_pass_records_created": False,
}
for key, value in expected.items():
    if key not in decision or type(decision[key]) is not type(value) or decision[key] != value:
        raise SystemExit(f"Owner release-scope decision does not match this exception: {key}")
print("Owner release-scope decision matches the exact artifact; formal qualification remains incomplete.")
PY
'''
            }
        }

        stage('Verify AAB') {
            when { expression { env.SKIP_AAB_BUILD != 'true' || env.REUSE_AAB_BUILD43 == 'true' } }
            steps {
                script {
                    gradleRelease('help', androidReleaseConfig([
                            requiresSigning: false,
                            keystoreVaultPath: null,
                            prepareScript: 'scripts/verify-android-release-bundle.sh',
                            extraArgs: ['--quiet']
                    ]))
                }
                withVault([vaultSecrets: [[
                    path: 'secret/jenkins/mobile/app/com.maksonlee.gststreamwall',
                    engineVersion: 2,
                    secretValues: [[
                        envVar: 'EXPECTED_UPLOAD_CERT_SHA256',
                        vaultKey: 'certificate_sha256'
                    ]]
                ]]]) {
                    sh '''#!/bin/bash
set -euo pipefail
export LC_ALL=C
aab=apps/android/app/build/outputs/bundle/release/app-release.aab
test -s "$aab"
signature_report=apps/android/app/build/outputs/bundle/release/signature-verification.txt
if ! jarsigner -verify "$aab" > "$signature_report" 2>&1; then
  cat "$signature_report" >&2
  exit 1
fi
grep -q 'jar verified.' "$signature_report"
if grep -qi 'unsigned entries' "$signature_report"; then
  cat "$signature_report" >&2
  echo 'AAB contains unsigned entries.' >&2
  exit 1
fi
echo 'AAB upload signature verified.'

expected_signer=$(printf %s "${EXPECTED_UPLOAD_CERT_SHA256:?ERROR: expected upload certificate SHA-256 is unset}" \
  | tr -d ':[:space:]' | tr '[:lower:]' '[:upper:]')
actual_signer=$(keytool -printcert -jarfile "$aab" \
  | awk -F': ' '$1 ~ /^[[:space:]]*SHA256$/ { print $2; exit }' \
  | tr -d ':[:space:]' | tr '[:lower:]' '[:upper:]')
if [[ ! "$expected_signer" =~ ^[0-9A-F]{64}$ ]]; then
  echo 'Vault certificate_sha256 must contain exactly one SHA-256 fingerprint.' >&2
  exit 1
fi
if [[ ! "$actual_signer" =~ ^[0-9A-F]{64}$ ]]; then
  echo 'Could not read exactly one AAB signer SHA-256 fingerprint.' >&2
  exit 1
fi
if [ "$actual_signer" != "$expected_signer" ]; then
  echo 'AAB signer does not match the approved reused upload certificate.' >&2
  exit 1
fi
echo 'AAB signer matches the approved reused upload certificate.'

entries=$(unzip -Z1 "$aab")
printf '%s\n' "$entries" | grep -qx 'base/lib/arm64-v8a/libgst_stream_wall_android.so'
printf '%s\n' "$entries" | grep -qx 'base/lib/arm64-v8a/libgstreamer_android.so'
unexpected_abi=$(printf '%s\n' "$entries" | awk -F/ \
  '$1 == "base" && $2 == "lib" && $3 != "arm64-v8a" { print $3 }' | sort -u)
if [ -n "$unexpected_abi" ]; then
  echo "Unexpected AAB native ABI: $unexpected_abi" >&2
  exit 1
fi

readelf_bin=/home/administrator/jenkins/android-cache/flutter-android-sdk/ndk/28.2.13676358/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-readelf
test -x "$readelf_bin"
native_check=target/aab-native-check
mkdir -p "$native_check"
printf '%s\n' "$entries" | awk -F/ \
  '$1 == "base" && $2 == "lib" && $3 == "arm64-v8a" && $4 ~ /[.]so$/' | while IFS= read -r entry; do
  name=${entry##*/}
  unzip -p "$aab" "$entry" > "$native_check/$name"
  alignments=$("$readelf_bin" -lW "$native_check/$name" | awk '$1 == "LOAD" { print $NF }' | sort -u)
  [ -n "$alignments" ]
  while IFS= read -r alignment; do
    if (( alignment < 0x4000 )); then
      echo "$name has insufficient LOAD alignment: $alignment" >&2
      exit 1
    fi
  done <<< "$alignments"
  echo "$name supports 16 KB pages"
done

sha256sum -c apps/android/app/build/outputs/bundle/release/app-release.aab.sha256
if [[ "${REUSE_AAB_BUILD43:-false}" == true ]]; then
  printf '%s  %s\n' "$RELEASE_EXPECTED_AAB_SHA256" "$aab" | sha256sum -c -
fi
'''
                }
                stash name: 'android-release-aab', includes: 'apps/android/app/build/outputs/bundle/release/*.aab,apps/android/app/build/outputs/bundle/release/*.sha256,apps/android/app/build/outputs/bundle/release/*.xml,apps/android/app/build/outputs/bundle/release/*.json,apps/android/app/build/outputs/bundle/release/signature-verification.txt,apps/android/app/build/outputs/mapping/release/**,apps/android/app/build/outputs/native-debug-symbols/release/**'
                archiveArtifacts artifacts: 'apps/android/app/build/outputs/bundle/release/*.aab,apps/android/app/build/outputs/bundle/release/*.sha256,apps/android/app/build/outputs/bundle/release/*.xml,apps/android/app/build/outputs/bundle/release/*.json,apps/android/app/build/outputs/bundle/release/signature-verification.txt,apps/android/app/build/outputs/mapping/release/**,apps/android/app/build/outputs/native-debug-symbols/release/**', fingerprint: true
            }
        }

        stage('Approve Google Play test upload') {
            when { expression { params.PUBLISH_TO_PLAY } }
            steps {
                script {
                    def qualification = env.REUSE_AAB_BUILD43 == 'true' ?
                            'Owner-authorized alpha.22 engineering-preview exception: corresponding-source readiness remains false and additional formal qualification remains incomplete. Exact verified build 43 AAB will be reused.' :
                            'Exact corresponding source has been confirmed ready.'
                    input message: "Upload ${env.RELEASE_VERSION_NAME} (${env.RELEASE_VERSION_CODE}) at ${env.RELEASE_COMMIT} to Google Play ${params.PLAY_TRACK} as ${params.PLAY_RELEASE_STATUS}? ${qualification}"
                }
            }
        }

        stage('Publish to Google Play test track') {
            when { expression { params.PUBLISH_TO_PLAY } }
            steps {
                script {
                    unstash 'android-release-aab'
                    sh '''#!/bin/bash
set -euo pipefail
source_aab=apps/android/app/build/outputs/bundle/release/app-release.aab
verified_aab_sha256=$(sha256sum "$source_aab")
verified_aab_sha256=${verified_aab_sha256%% *}
sha256sum -c "$source_aab.sha256"
if [[ "${REUSE_AAB_BUILD43:-false}" == true ]]; then
  printf '%s  %s\n' "$RELEASE_EXPECTED_AAB_SHA256" "$source_aab" | sha256sum -c -
fi

# GPP uploads every matching AAB in artifactDir. Start with an empty
# publication directory and stage only the artifact verified above.
publication_dir=apps/android/app/build/outputs/play-publication
rm -rf -- "$publication_dir"
mkdir -p "$publication_dir"
install -m 0644 "$source_aab" "$publication_dir/app-release.aab"
printf '%s  %s\n' "$verified_aab_sha256" "$publication_dir/app-release.aab" | sha256sum -c -
'''
                    def publicationConfig = [
                            playServiceVaultPath: 'secret/jenkins/mobile/shared/play-service',
                            playJsonPath: '/tmp/gst-stream-wall-play-service.json',
                            track: params.PLAY_TRACK,
                            extraArgs: ['--artifact-dir=app/build/outputs/play-publication'],
                            extraProps: [
                                    'release.versionCode': env.RELEASE_VERSION_CODE,
                                    'release.versionName': env.RELEASE_VERSION_NAME,
                                    'play.releaseStatus': params.PLAY_RELEASE_STATUS
                            ]
                    ]
                    if (env.REUSE_AAB_BUILD43 == 'true') {
                        // Play Publisher registers only signed variants. Keep
                        // the normal masked signing inputs for task discovery;
                        // --artifact-dir still uploads the existing AAB.
                        publicationConfig += [
                                prepareScript: ''
                        ]
                    }
                    gradleRelease(':app:publishReleaseBundle', androidReleaseConfig(publicationConfig))
                }
            }
        }

        stage('Approve existing Play release promotion') {
            when { expression { params.PROMOTE_EXISTING_TO_PLAY } }
            steps {
                input message: "Promote existing version code ${env.RELEASE_VERSION_CODE} from Google Play internal to ${params.PLAY_TRACK} as ${params.PLAY_RELEASE_STATUS}? No AAB will be uploaded."
            }
        }

        stage('Promote existing Google Play release') {
            when { expression { params.PROMOTE_EXISTING_TO_PLAY } }
            steps {
                script {
                    gradleRelease(':app:promoteArtifact', androidReleaseConfig([
                            requiresSigning: false,
                            keystoreVaultPath: null,
                            playServiceVaultPath: 'secret/jenkins/mobile/shared/play-service',
                            playJsonPath: '/tmp/gst-stream-wall-play-service.json',
                            prepareScript: '',
                            extraArgs: [
                                    '--from-track=internal',
                                    "--promote-track=${params.PLAY_TRACK}",
                                    "--release-status=${params.PLAY_RELEASE_STATUS}",
                                    "--version-code=${env.RELEASE_VERSION_CODE}"
                            ]
                    ]))
                }
            }
        }

        stage('Approve Play Store listing update') {
            when { expression { params.PUBLISH_LISTING_TO_PLAY } }
            steps {
                input message: "Update the en-US and zh-TW Play Store listings from ${env.RELEASE_COMMIT}? No AAB or release track will be changed."
            }
        }

        stage('Publish Play Store listings') {
            when { expression { params.PUBLISH_LISTING_TO_PLAY } }
            steps {
                script {
                    gradleRelease(':app:publishListing', androidReleaseConfig([
                            requiresSigning: false,
                            keystoreVaultPath: null,
                            playServiceVaultPath: 'secret/jenkins/mobile/shared/play-service',
                            playJsonPath: '/tmp/gst-stream-wall-play-service.json'
                    ]))
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}

def androidReleaseConfig(Map overrides = [:]) {
    def cacheRoot = '/home/administrator/jenkins/android-cache'
    def insideArgs = [
            "-v ${cacheRoot}/rust/cargo:/home/ubuntu/.cargo",
            "-v ${cacheRoot}/flutter-android-sdk:/home/ubuntu/Android:ro",
            '-v /home/administrator/.cache/gst-stream-wall/gstreamer-android-1.28.8:/opt/gstreamer:ro',
            '-e HOME=/home/ubuntu',
            '-e CARGO_HOME=/home/ubuntu/.cargo',
            '-e RUSTUP_HOME=/opt/rust/rustup',
            '-e RUSTUP_BIN_DIR=/opt/rust/cargo/bin',
            '-e RUST_TOOLCHAIN_VERSION=1.98.0',
            '-e ANDROID_HOME=/home/ubuntu/Android',
            '-e ANDROID_SDK_ROOT=/home/ubuntu/Android',
            '-e GSTREAMER_ROOT_ANDROID=/opt/gstreamer',
            '-e BUNDLETOOL_JAR=/opt/bundletool/bundletool-all-1.18.3.jar',
            '-e PATH=/opt/rust/cargo/bin:/home/ubuntu/Android/cmake/3.22.1/bin:/home/ubuntu/Android/cmdline-tools/latest/bin:/home/ubuntu/Android/platform-tools:/home/ubuntu/.sdkman/candidates/java/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    ].join(' ')

    return [
            image: 'harbor.maksonlee.com/library/gst-stream-wall-android-build-env@sha256:11e2a4f7a262afd5a28c2280b7b0114db541d24e7eff498dee79e4a55a10dad1',
            workDir: 'apps/android',
            insideArgs: insideArgs,
            mountAndroidCache: false,
            prepareScript: 'scripts/ensure-android-rust-toolchain.sh',
            // AAB publication and Store Listing publication have separate
            // approvals. Never let the shared helper auto-upgrade
            // publishReleaseBundle to publishReleaseApps for this project.
            publishPlayListings: false,
            keystoreVaultPath: 'secret/jenkins/mobile/app/com.maksonlee.gststreamwall',
            jksPath: '/tmp/gst-stream-wall-upload.jks',
            passSigningProperties: false,
            maxWorkers: 1
    ] + overrides
}
