@Library('jenkins-shared-lib') _

// CI for maksonlee/gst-stream-wall main: the repository's documented Android debug gate (unit tests, debug lint and
// the shell debug APK, which needs no GStreamer SDK) in the same image and Rust toolchain as the release job. It
// reads no signing material and no Play credentials.
pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                git branch: 'main', credentialsId: 'vault-github-ssh',
                        url: 'git@github.com:maksonlee/gst-stream-wall.git'
                sh '''#!/bin/bash
set -euo pipefail
echo "gst-stream-wall main: $(git rev-parse HEAD)"
test -x scripts/ensure-android-rust-toolchain.sh
install -d /home/administrator/jenkins/android-cache/rust/cargo
'''
            }
        }

        stage('Test, lint and build the shell debug APK') {
            steps {
                script {
                    def cacheRoot = '/home/administrator/jenkins/android-cache'
                    def insideArgs = [
                            "-v ${cacheRoot}/rust/cargo:/home/ubuntu/.cargo",
                            "-v ${cacheRoot}/flutter-android-sdk:/home/ubuntu/Android:ro",
                            '-e HOME=/home/ubuntu',
                            '-e CARGO_HOME=/home/ubuntu/.cargo',
                            '-e RUSTUP_HOME=/opt/rust/rustup',
                            '-e RUSTUP_BIN_DIR=/opt/rust/cargo/bin',
                            '-e RUST_TOOLCHAIN_VERSION=1.98.0',
                            '-e ANDROID_HOME=/home/ubuntu/Android',
                            '-e ANDROID_SDK_ROOT=/home/ubuntu/Android',
                            '-e PATH=/opt/rust/cargo/bin:/home/ubuntu/Android/cmake/3.22.1/bin:/home/ubuntu/Android/cmdline-tools/latest/bin:/home/ubuntu/Android/platform-tools:/home/ubuntu/.sdkman/candidates/java/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
                    ].join(' ')
                    gradleRelease(':app:assembleDebug', [
                            requiresSigning: false,
                            image: buildImages.gstStreamWall(),
                            workDir: 'apps/android',
                            insideArgs: insideArgs,
                            mountAndroidCache: false,
                            prepareScript: 'scripts/ensure-android-rust-toolchain.sh',
                            publishPlayListings: false,
                            maxWorkers: 1,
                            extraArgs: [':app:testDebugUnitTest', ':app:lintDebug']
                    ])
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'apps/android/app/build/test-results/**/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'apps/android/app/build/outputs/apk/debug/*.apk,apps/android/app/build/reports/lint-results-debug.*',
                    allowEmptyArchive: true, fingerprint: true
        }
        cleanup {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
