@Library('jenkins-shared-lib') _

pipeline {
    agent { label 'ssh-agent-with-docker' }

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        string(name: 'SOURCE_BUILD_NUMBER', defaultValue: '1', description: 'Exact Math Runner signed AAB build number')
        string(name: 'EXPECTED_AAB_SHA256', defaultValue: 'a22ec535fd6e587640198109bbe153813665b15ecac0ec76dcf8621d3a624931', description: 'Expected archive AAB SHA-256 (64 lowercase hex characters)')
        string(name: 'REPLACE_DRAFT_VERSION_CODE', defaultValue: '', description: 'Existing internal draft versionCode to replace; leave empty for the original strict route')
        string(name: 'EXPECTED_REPLACED_DRAFT_SHA256', defaultValue: '', description: 'Expected Play bundle SHA-256 for that existing internal draft; paired with its versionCode')
        string(name: 'RELEASE_STATUS', defaultValue: 'draft', description: 'internal release status: draft or completed')
        booleanParam(name: 'PUBLISH_TO_PLAY', defaultValue: false, description: 'Requires a separate manual approval before any Play API write')
    }

    environment {
        PUBLISHER_SCRIPT = 'pipeline-source/Jenkinsfile/unity/math-runner-play-internal/publish.py'
        PUBLISHER_SHA256 = 'c78e655c4378f5888032c832d19c5d28cb2f2d71810fceac6896e8737590de36'
    }

    stages {
        stage('Validate request') {
            steps {
                script {
                    if (!(params.SOURCE_BUILD_NUMBER ==~ /^[1-9][0-9]{0,7}$/)) {
                        error 'SOURCE_BUILD_NUMBER must be a positive exact build number'
                    }
                    if (!(params.EXPECTED_AAB_SHA256 ==~ /^[0-9a-f]{64}$/)) {
                        error 'EXPECTED_AAB_SHA256 must be 64 lowercase hex characters'
                    }
                    if (!(params.RELEASE_STATUS in ['draft', 'completed'])) {
                        error 'RELEASE_STATUS must be draft or completed'
                    }
                    def oldCode = params.REPLACE_DRAFT_VERSION_CODE ?: ''
                    def oldSha = params.EXPECTED_REPLACED_DRAFT_SHA256 ?: ''
                    if (!!oldCode != !!oldSha) {
                        error 'Previous draft versionCode and SHA-256 must be supplied together'
                    }
                    if (oldCode && !(oldCode ==~ /^[1-9][0-9]{0,7}$/)) {
                        error 'REPLACE_DRAFT_VERSION_CODE must be a positive versionCode'
                    }
                    if (oldSha && !(oldSha ==~ /^[0-9a-f]{64}$/)) {
                        error 'EXPECTED_REPLACED_DRAFT_SHA256 must be 64 lowercase hex characters'
                    }
                    if (oldCode && params.RELEASE_STATUS != 'draft') {
                        error 'Replacing an internal draft requires RELEASE_STATUS=draft'
                    }
                }
            }
        }

        stage('Fetch publisher source') {
            steps {
                deleteDir()
                dir('pipeline-source') {
                    checkout scm
                }
                sh '''#!/bin/bash
set -euo pipefail
printf '%s  %s\n' "$PUBLISHER_SHA256" "$PUBLISHER_SCRIPT" | sha256sum --check --status
python3 -c 'import cryptography'
git -C pipeline-source rev-parse HEAD
'''
            }
        }

        stage('Download and verify Artifactory AAB') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
test ! -e artifact
test ! -L artifact
'''
                script {
                    env.ARTIFACTORY_TARGET = "android-snapshots/com/maksonlee/math-runner/jenkins-build-${params.SOURCE_BUILD_NUMBER}-sha256-${params.EXPECTED_AAB_SHA256}-SNAPSHOT/"
                    echo "Downloading exact Artifactory AAB proof from ${env.ARTIFACTORY_TARGET}"
                    def spec = groovy.json.JsonOutput.toJson([files: [[
                        pattern: env.ARTIFACTORY_TARGET + '*',
                        target: 'artifactory-raw/',
                        flat: true
                    ]]])
                    rtDownload(serverId: 'artifactory', spec: spec, failNoOp: true)
                }
                sh '''#!/bin/bash
set -euo pipefail
python3 - <<'PY'
import pathlib

stored_to_canonical = {
    'SportsDayMath.aab': 'SportsDayMath.aab',
    'SportsDayMath.aab.sha256.txt': 'SportsDayMath.aab.sha256',
    'SportsDayMath.aab.signer-sha256': 'SportsDayMath.aab.signer-sha256',
    'release-verification.json': 'release-verification.json',
    'AndroidManifest.xml': 'AndroidManifest.xml',
    'signature-verification.txt': 'signature-verification.txt',
    'Android-AndroidBuildReport.json': 'Android-AndroidBuildReport.json',
}
source = pathlib.Path('artifactory-raw')
if not source.is_dir() or source.is_symlink():
    raise SystemExit('Artifactory download did not create a regular directory')
files = list(source.iterdir())
if {p.name for p in files} != set(stored_to_canonical) or any(not p.is_file() or p.is_symlink() for p in files):
    raise SystemExit('Artifactory seven-file inventory is missing or unexpected')
destination = pathlib.Path('artifact')
if destination.exists() or destination.is_symlink():
    raise SystemExit('Artifact destination is not empty')
destination.mkdir()
for stored, canonical in stored_to_canonical.items():
    (destination / canonical).write_bytes((source / stored).read_bytes())
PY
'''
                sh '''#!/bin/bash
set -euo pipefail
python3 "$PUBLISHER_SCRIPT" verify "$SOURCE_BUILD_NUMBER" "$EXPECTED_AAB_SHA256" artifact
'''
                archiveArtifacts artifacts: 'artifact/verified.json', fingerprint: true
                script {
                    env.APPROVAL_SUMMARY = sh(
                        script: '''#!/bin/bash
set -euo pipefail
python3 "$PUBLISHER_SCRIPT" describe artifact/verified.json "$EXPECTED_AAB_SHA256" "$RELEASE_STATUS" "$REPLACE_DRAFT_VERSION_CODE" "$EXPECTED_REPLACED_DRAFT_SHA256"
''',
                        returnStdout: true
                    ).trim()
                    env.APPROVED_REPORT_SHA256 = sh(
                        script: "sha256sum artifact/verified.json | cut -d' ' -f1",
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Approve Play internal action') {
            when { expression { params.PUBLISH_TO_PLAY } }
            steps {
                input message: "Approve this exact Play internal action? ${env.APPROVAL_SUMMARY}. A specified previous draft is removed only in the same edit as its replacement; no separate delete is used."
            }
        }

        stage('Publish to Play internal') {
            when { expression { params.PUBLISH_TO_PLAY } }
            steps {
                sh '''#!/bin/bash
set -euo pipefail
printf '%s  %s\n' "$PUBLISHER_SHA256" "$PUBLISHER_SCRIPT" | sha256sum --check --status
printf '%s  %s\n' "$APPROVED_REPORT_SHA256" artifact/verified.json | sha256sum --check --status
printf '%s  %s\n' "$EXPECTED_AAB_SHA256" artifact/SportsDayMath.aab | sha256sum --check --status
'''
                withVault([vaultSecrets: [[
                    path: 'secret/jenkins/mobile/shared/play-service',
                    engineVersion: 2,
                    secretValues: [[envVar: 'PLAY_SERVICE_JSON_B64', vaultKey: 'json_b64']]
                ]]]) {
                    sh '''#!/bin/bash
set +x
set -euo pipefail
umask 077
python3 "$PUBLISHER_SCRIPT" publish artifact/verified.json "$EXPECTED_AAB_SHA256" "$RELEASE_STATUS" "$REPLACE_DRAFT_VERSION_CODE" "$EXPECTED_REPLACED_DRAFT_SHA256"
'''
                }
                archiveArtifacts artifacts: 'artifact/publish-result.json', fingerprint: true
            }
        }
    }

    post {
        always {
            script {
                if (fileExists('artifact/publish-attempt.json')) {
                    archiveArtifacts artifacts: 'artifact/publish-attempt.json', fingerprint: true
                }
            }
            cleanWs(deleteDirs: true, notFailBuild: false)
        }
    }
}
